<Window x:Class="FusePlayer.GoToTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aller à un temps spécifique"
        Width="520" Height="278"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="TimeField" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="#FF0D1117" />
            <Setter Property="Foreground" Value="#FFF4F5F7" />
            <Setter Property="BorderBrush" Value="#FF3A414C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFF7A45" />
            <Setter Property="SelectionBrush" Value="#88FF7A45" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
    </Window.Resources>

    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="17,0,8,0"
                               Text="Aller à un temps spécifique"
                               Foreground="#FFF4F5F7"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <Button Grid.Column="1"
                            Width="42" Height="42"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fermer"
                            Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="22,15,22,3"
                       Text="Entrez la position exacte dans le média."
                       Foreground="#FFC7CBD1" FontSize="12.5" />
            <TextBlock x:Name="DurationHintText" Grid.Row="2" Margin="22,0,22,12"
                       Foreground="#FF8C929F" FontSize="11.5" />

            <Grid Grid.Row="3" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="HoursTextBox" Grid.Column="0"
                         AutomationProperties.Name="Heures"
                         Style="{StaticResource TimeField}" MaxLength="6"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged" />
                <TextBlock Grid.Column="1" Text=":" Foreground="#FFD8DBDF"
                           FontFamily="Cascadia Mono" FontSize="21"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox x:Name="MinutesTextBox" Grid.Column="2"
                         AutomationProperties.Name="Minutes"
                         Style="{StaticResource TimeField}" MaxLength="2"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged" />
                <TextBlock Grid.Column="3" Text=":" Foreground="#FFD8DBDF"
                           FontFamily="Cascadia Mono" FontSize="21"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox x:Name="SecondsTextBox" Grid.Column="4"
                         AutomationProperties.Name="Secondes"
                         Style="{StaticResource TimeField}" MaxLength="2"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged" />
                <TextBlock Grid.Column="5" Text="." Foreground="#FFD8DBDF"
                           FontFamily="Cascadia Mono" FontSize="21"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox x:Name="MillisecondsTextBox" Grid.Column="6"
                         AutomationProperties.Name="Millisecondes"
                         Style="{StaticResource TimeField}" MaxLength="3"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" Text="Heures"
                           Foreground="#FF8C929F" FontSize="10.5" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" Text="Minutes"
                           Foreground="#FF8C929F" FontSize="10.5" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,5,0,0" Text="Secondes"
                           Foreground="#FF8C929F" FontSize="10.5" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="6" Margin="0,5,0,0" Text="Millisecondes"
                           Foreground="#FF8C929F" FontSize="10.5" HorizontalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="22,9,22,0"
                       Foreground="#FFFF6B73" FontSize="11.5"
                       Visibility="Collapsed" />

            <Grid Grid.Row="5" Margin="22,12,22,18">
                <Button Content="Réinitialiser"
                        Style="{StaticResource TextButton}"
                        HorizontalAlignment="Left"
                        Click="Reset_OnClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Style="{StaticResource TextButton}"
                            Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
                    <Button Content="Aller"
                            Style="{StaticResource TextButton}"
                            Background="#FFFF7A45" BorderBrush="#FFFF7A45"
                            Foreground="#FF120B07" FontWeight="SemiBold"
                            IsDefault="True" Click="Confirm_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
