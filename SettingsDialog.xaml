                                                  Unchecked="AutoSelectPreferredAudioCheckBox_OnChanged"
                                                  automation:AutomationProperties.Name="Sélectionner automatiquement la piste audio préférée" />
                                    </Grid>
                                    <ComboBox x:Name="PreferredAudioComboBox" Style="{StaticResource SettingsComboBox}"
                                              SelectionChanged="PreferredAudioComboBox_OnSelectionChanged"
                                              automation:AutomationProperties.Name="Langue audio préférée">
                                        <ComboBoxItem Content="Désactivée" Tag="disabled" />
                                        <ComboBoxItem Content="Français québécois (VFQ)" Tag="vfq" />
                                        <ComboBoxItem Content="Français de France (VFF)" Tag="vff" />
                                        <ComboBoxItem Content="Version originale (VO)" Tag="vo" />
                                        <ComboBoxItem Content="Français" Tag="fr" />
                                        <ComboBoxItem Content="Anglais" Tag="en" />
                                        <ComboBoxItem Content="Japonais" Tag="ja" />
                                        <ComboBoxItem Content="Mes priorités personnalisées" Tag="custom" />
                                    </ComboBox>
                                    <StackPanel x:Name="PreferredAudioCustomControls" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Titres de piste recherchés"
                                                           Foreground="#FFF0F1F3" FontSize="12" />
