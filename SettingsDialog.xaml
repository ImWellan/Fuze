                                            <TextBlock Text="LIGNE GAUCHE" Foreground="#FFFFB276" FontSize="10.5" FontWeight="SemiBold" />
                                            <ListBox x:Name="BottomBarLeftListBox" Height="150" Margin="0,6,0,0"
                                                     Background="#FF0C1016" BorderBrush="#FF343C47" BorderThickness="1"
                                                     Foreground="#FFE8EBEF" ItemContainerStyle="{StaticResource BottomBarLayoutListItem}"
                                                     ItemTemplate="{StaticResource BottomBarLayoutItemTemplate}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="BottomBarLayoutList_OnPreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="BottomBarLayoutList_OnPreviewMouseMove"
                                                     DragOver="BottomBarLayoutList_OnDragOver"
                                                     Drop="BottomBarLayoutList_OnDrop" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LIGNE CENTRALE" Foreground="#FFFFB276" FontSize="10.5" FontWeight="SemiBold" />
                                            <ListBox x:Name="BottomBarCenterListBox" Height="150" Margin="0,6,0,0"
                                                     Background="#FF0C1016" BorderBrush="#FF343C47" BorderThickness="1"
                                                     Foreground="#FFE8EBEF" ItemContainerStyle="{StaticResource BottomBarLayoutListItem}"
                                                     ItemTemplate="{StaticResource BottomBarLayoutItemTemplate}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="BottomBarLayoutList_OnPreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="BottomBarLayoutList_OnPreviewMouseMove"
                                                     DragOver="BottomBarLayoutList_OnDragOver"
                                                     Drop="BottomBarLayoutList_OnDrop" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="LIGNE DROITE" Foreground="#FFFFB276" FontSize="10.5" FontWeight="SemiBold" />
                                            <ListBox x:Name="BottomBarRightListBox" Height="150" Margin="0,6,0,0"
                                                     Background="#FF0C1016" BorderBrush="#FF343C47" BorderThickness="1"
                                                     Foreground="#FFE8EBEF" ItemContainerStyle="{StaticResource BottomBarLayoutListItem}"
                                                     ItemTemplate="{StaticResource BottomBarLayoutItemTemplate}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="BottomBarLayoutList_OnPreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="BottomBarLayoutList_OnPreviewMouseMove"
                                                     DragOver="BottomBarLayoutList_OnDragOver"
                                                     Drop="BottomBarLayoutList_OnDrop" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Content="←" Tag="left" Style="{StaticResource PriorityIconButton}" Margin="0,0,4,0"
                                                    ToolTip="Déplacer l’élément sélectionné vers la ligne de gauche"
                                                    Click="MoveBottomBarItem_OnClick" />
                                            <Button Content="↑" Tag="up" Style="{StaticResource PriorityIconButton}" Margin="0,0,4,0"
                                                    ToolTip="Monter l’élément sélectionné dans sa ligne"
                                                    Click="MoveBottomBarItem_OnClick" />
                                            <Button Content="↓" Tag="down" Style="{StaticResource PriorityIconButton}" Margin="0,0,4,0"
                                                    ToolTip="Descendre l’élément sélectionné dans sa ligne"
                                                    Click="MoveBottomBarItem_OnClick" />
                                            <Button Content="→" Tag="right" Style="{StaticResource PriorityIconButton}"
                                                    ToolTip="Déplacer l’élément sélectionné vers la ligne de droite"
                                                    Click="MoveBottomBarItem_OnClick" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Espacement" Foreground="#FF9EA5AF" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="BottomBarSpacingTextBox" Width="94" Height="38"
                                                     Style="{StaticResource SettingsTextBox}"
                                                     TextChanged="BottomBarSpacingTextBox_OnTextChanged"
                                                     ToolTip="Espacement automatique entre les éléments (0 à 24)" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Margin="0,2,0,10" Background="#543C444F" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="MODÈLE ENREGISTRÉ" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Le modèle actif est appliqué à la barre dès l’enregistrement des paramètres."
                                                       Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="BottomBarPresetComboBox" Grid.Column="1" Width="180" Height="38"
                                                  Margin="10,0,0,0" Style="{StaticResource SettingsComboBox}"
                                                  SelectionChanged="BottomBarPresetComboBox_OnSelectionChanged" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BottomBarPresetNameTextBox" Height="34" Padding="10,5"
                                                 VerticalContentAlignment="Center"
                                                 Background="#FF0C1016" Foreground="#FFF4F5F7" BorderBrush="#FF3D4550"
                                                 BorderThickness="1" FontSize="12.5" ToolTip="Nom du modèle de barre" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Enregistrer" Style="{StaticResource TextButton}" Margin="0,0,5,0"
                                                    ToolTip="Enregistrer les changements dans ce modèle"
                                                    Click="SaveBottomBarPreset_OnClick" />
                                            <Button Content="Enregistrer sous" Style="{StaticResource TextButton}" Margin="0,0,5,0"
                                                    ToolTip="Créer un autre modèle à partir de cette mise en page"
                                                    Click="SaveBottomBarPresetAs_OnClick" />
                                            <Button Content="Supprimer" Style="{StaticResource TextButton}"
                                                    ToolTip="Supprimer le modèle personnalisé sélectionné"
                                                    Click="DeleteBottomBarPreset_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="FENÊTRE ET AFFICHAGE" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10" Text="Réglez la fenêtre, le pointeur et les informations affichées à l’écran."
                                               Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Adapter l’interface à la fenêtre" Foreground="#FFF0F1F3" FontSize="12.5" /><TextBlock Text="Ajuste automatiquement la taille des contrôles à l’espace disponible, en respectant la mise à l’échelle Windows." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" /></StackPanel>
                                        <CheckBox x:Name="AdaptiveInterfaceScaleCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Masquer automatiquement la souris" Foreground="#FFF0F1F3" FontSize="12.5" /><TextBlock Text="Active ou désactive le masquage du pointeur selon le délai configuré juste en dessous." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" /></StackPanel>
                                        <CheckBox x:Name="AutoHideCursorCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid MinHeight="57">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Délai du moniteur de souris" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Masque le pointeur après ce délai sans mouvement. Chaque mouvement réinitialise le délai; il ne s’écoule pas tant que la souris bouge." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="CursorAutoHideDelayTextBox"
                                                     Style="{StaticResource SettingsTextBox}"
                                                     automation:AutomationProperties.Name="Délai du moniteur de souris en secondes" />
                                            <TextBlock Text="s" Margin="0,0,11,0" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="#FF858C97"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid MinHeight="60">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Toujours au-dessus" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Garde la fenêtre Fuze devant les autres fenêtres, même lorsqu’une autre application devient active." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Afficher les informations à l’écran" Foreground="#FFF0F1F3" FontSize="12.5" /><TextBlock Text="Autorise les messages temporaires, titres et informations OSD." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" /></StackPanel>
                                        <CheckBox x:Name="ShowOsdCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="MOLETTE" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Choisissez les actions que la molette peut effectuer dans l’interface et au centre de la vidéo."
                                               Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,5"
                                               Text="Dans la zone centrale de la vidéo (une seule action à la fois) :"
                                               Foreground="#FFB8BEC7" FontSize="10.5" TextWrapping="Wrap" />
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="CenterWheelVolumeCheckBox"
                                                  Grid.Column="0" Margin="0,2,12,2"
                                                  Content="Molette centrale : volume"
                                                  ToolTip="La molette au centre de la vidéo règle le volume."
                                                  Checked="CenterWheelVolumeCheckBox_OnChecked"
                                                  Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="CenterWheelTimelineCheckBox"
                                                  Grid.Column="1" Margin="0,2,0,2"
                                                  Content="Molette centrale : temps"
                                                  ToolTip="La molette au centre de la vidéo avance ou recule dans la vidéo."
                                                  Checked="CenterWheelTimelineCheckBox_OnChecked"
                                                  Style="{StaticResource SettingsToggleWithText}" />
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="MouseWheelTimelineCheckBox" Margin="0,2,12,2"
                                                  Content="Barre de temps" Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="MouseWheelVolumeCheckBox" Margin="0,2,0,2"
                                                  Content="Volume" Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="MouseWheelAudioTracksCheckBox" Margin="0,2,12,2"
                                                  Content="Pistes audio" Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="MouseWheelSubtitleTracksCheckBox" Margin="0,2,0,2"
                                                  Content="Sous-titres" Style="{StaticResource SettingsToggleWithText}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SystemLanguageCard" Margin="0,0,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid MinHeight="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="LANGUE DU SYSTÈME" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,14,0"
                                                   Text="Choisissez la langue utilisée par le système et les interfaces de Fuse."
                                                   Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="InterfaceLanguageComboBox" Grid.Column="1"
                                              Width="180" Height="38" VerticalAlignment="Center"
                                              Style="{StaticResource SettingsComboBox}"
                                              SelectionChanged="InterfaceLanguageComboBox_OnSelectionChanged"
                                              automation:AutomationProperties.Name="Langue du système">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Français" Tag="fr" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border x:Name="ChapterTimeBarCard" Margin="0,0,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="INFO-BULLES" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,14,0"
                                                   Text="Désactive les petites descriptions qui apparaissent lorsque la souris reste au-dessus d’un élément."
                                                   Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="DisableToolTipsCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              automation:AutomationProperties.Name="Désactiver les info-bulles" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NOM DU CHAPITRE DANS LA BULLE DU TEMPS"
                                                   Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,14,0"
                                                   Text="Affiche le nom du chapitre actif avec l’horodatage lorsque vous survolez la barre de temps."
                                                   Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowChapterNameInSeekPreviewCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              IsChecked="True"
                                              automation:AutomationProperties.Name="Afficher le nom du chapitre dans la bulle du temps" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,14" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="CLICS DANS LA ZONE VIDÉO" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Active ou désactive les actions rapides dans la zone libre de l’image."
                                               Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    <Grid MinHeight="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Clic simple : lecture / pause" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Un clic dans la zone libre bascule la lecture." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="TogglePlaybackOnSingleClickCheckBox" Grid.Column="1"
                                                  VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                                  automation:AutomationProperties.Name="Activer le clic simple pour lecture pause" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid MinHeight="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Double-clic : plein écran" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Un double-clic dans la zone libre bascule le plein écran." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ToggleFullscreenOnDoubleClickCheckBox" Grid.Column="1"
                                                  VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                                  automation:AutomationProperties.Name="Activer le double clic pour le plein écran" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AudioPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="AUDIO" Foreground="#FFF4F5F7"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,17"
                                       Text="Préférences de sortie, pistes, canaux et traitements audio."
                                       Foreground="#FFA7ADB6" FontSize="12.5" />

                            <Border Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AUDIO AU DÉMARRAGE"
                                                   Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0"
                                                   Text="Chaque nouveau média démarre sans audio. Un choix manuel reste possible pendant la lecture."
                                                   Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="DisableAudioByDefaultCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              Checked="DisableAudioByDefaultCheckBox_OnChanged"
                                              Unchecked="DisableAudioByDefaultCheckBox_OnChanged"
                                              automation:AutomationProperties.Name="Désactiver l’audio au démarrage" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="62" />
                                        <RowDefinition Height="67" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="VOLUME" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Toujours rétablir le volume au démarrage"
                                                       Foreground="#FFF0F1F3" FontSize="13" />
                                            <TextBlock Margin="0,2,15,0"
                                                       Text="Sinon, Fuze reprend le dernier volume utilisé."
                                                       Foreground="#FF8E96A1" FontSize="11" />
                                        </StackPanel>
                                        <CheckBox x:Name="ResetVolumeCheckBox" Grid.Column="1"
                                                  VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                                  Checked="ResetVolumeCheckBox_OnChanged"
                                                  Unchecked="ResetVolumeCheckBox_OnChanged"
                                                  automation:AutomationProperties.Name="Toujours rétablir le volume au démarrage" />
                                    </Grid>
                                    <Grid x:Name="StartupVolumeControls" Grid.Row="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="0" Foreground="#FF858C97" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="StartupVolumeSlider" Grid.Column="1" Margin="12,0"
                                                Minimum="0" Maximum="125" TickFrequency="1"
                                                SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="StartupVolumeSlider_OnValueChanged"
                                                automation:AutomationProperties.Name="Volume au démarrage" />
                                        <Border Grid.Column="2" Height="36" Background="#FF0C1016"
                                                BorderBrush="#FF3D4550" BorderThickness="1" CornerRadius="7">
                                            <TextBlock x:Name="StartupVolumeText" Text="100 %"
                                                       Foreground="#FFF4F5F7" FontFamily="Cascadia Mono"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="PÉRIPHÉRIQUE DE SORTIE" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Le choix manuel remplace le mode audio adaptatif."
                                                   Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="AudioDeviceComboBox" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource SettingsComboBox}"
                                              SelectionChanged="AudioDeviceComboBox_OnSelectionChanged"
                                              automation:AutomationProperties.Name="Périphérique audio" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CHANGEMENT AUTOMATIQUE DE SORTIE" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0" Text="Bascule automatiquement vers un casque ou une nouvelle sortie audio détectée."
                                                   Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoSwitchAudioDeviceCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="MODE AUDIO ADAPTATIF" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Sélectionnez ce mode dans Périphérique de sortie pour utiliser automatiquement la sortie audio associée à l’écran actif."
                                               Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    <StackPanel x:Name="AdaptiveAudioMappingsPanel" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
