                                            <TextBlock x:Name="SubtitlePreviewPositionLabel" Margin="10,8"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Foreground="#A8CAD0D8" FontSize="10.5"
                                                       Text="Sous-titre • Bas centre" IsHitTestVisible="False" />
                                            <Grid x:Name="SubtitlePreviewTextHost" Margin="18"
                                                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                  IsHitTestVisible="False">
                                                <TextBlock x:Name="SubtitlePreviewShadowText"
                                                           Text="Exemple de sous-titre" TextAlignment="Center" />
                                                <TextBlock x:Name="SubtitlePreviewOutlineText"
                                                           Text="Exemple de sous-titre" TextAlignment="Center" />
                                                <TextBlock x:Name="SubtitlePreviewText"
                                                           Text="Exemple de sous-titre" TextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PositionCardBorder" Margin="0,14,0,14" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PositionSectionTitleText" Text="POSITION"
                                                       Foreground="#FFFF9A48"
                                                       FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock x:Name="PositionSectionDescriptionText" Margin="0,4,14,0"
                                                       Text="Sélectionnez d’abord l’élément à modifier dans la section Apparence."
                                                       Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="SubtitleForcePositionCheckBox" Grid.Column="1"
                                                  VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                                  Checked="SubtitleForcePositionCheckBox_OnChanged"
                                                  Unchecked="SubtitleForcePositionCheckBox_OnChanged"
                                                  automation:AutomationProperties.Name="Forcer la position des sous-titres" />
                                    </Grid>
                                    <StackPanel x:Name="SubtitlePositionControls" Margin="0,13,0,0">
                                        <TextBlock Text="Point d’ancrage" Foreground="#FFF0F1F3" FontSize="12" />
                                        <ComboBox x:Name="SubtitlePositionComboBox" Margin="0,6,0,12"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  SelectionChanged="SubtitlePreviewSetting_OnChanged"
                                                  automation:AutomationProperties.Name="Position forcée des sous-titres" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Marge horizontale" Foreground="#FFF0F1F3" FontSize="12" />
                                                    <TextBlock Text="0 à 500 px" Foreground="#FF7F8792" FontSize="10.5" />
                                                </StackPanel>
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="SubtitleMarginXTextBox" Width="94"
                                                             Style="{StaticResource SettingsTextBox}"
                                                             TextChanged="SubtitlePreviewSetting_OnTextChanged"
                                                             automation:AutomationProperties.Name="Marge horizontale des sous-titres" />
                                                    <TextBlock Text="px" Margin="0,0,9,0" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" Foreground="#FF858C97"
                                                               IsHitTestVisible="False" />
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Marge verticale" Foreground="#FFF0F1F3" FontSize="12" />
                                                    <TextBlock Text="0 à 500 px" Foreground="#FF7F8792" FontSize="10.5" />
                                                </StackPanel>
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="SubtitleMarginYTextBox" Width="94"
                                                             Style="{StaticResource SettingsTextBox}"
                                                             TextChanged="SubtitlePreviewSetting_OnTextChanged"
                                                             automation:AutomationProperties.Name="Marge verticale des sous-titres" />
                                                    <TextBlock Text="px" Margin="0,0,9,0" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" Foreground="#FF858C97"
                                                               IsHitTestVisible="False" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ShortcutsPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ShortcutsPanel_OnPreviewMouseWheel">
                        <StackPanel>
                            <TextBlock Text="RACCOURCIS" Foreground="#FFF4F5F7"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,17"
                                       Text="Touches du clavier, molette et boutons multimédias."
                                       Foreground="#FFA7ADB6" FontSize="12.5" />

                            <Border Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="RACCOURCIS CLAVIER" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Recherchez une commande, puis double-cliquez sur sa touche pour la modifier."
                                               Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    <TextBox x:Name="ShortcutSearchTextBox" Height="36" Margin="0,0,0,12"
                                             Padding="11,6" Background="#FF0C1016" Foreground="#FFF4F5F7"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="#FF3D4550" BorderThickness="1"
                                             CaretBrush="#FFFF8A42" SelectionBrush="#88FF7A45"
                                             FontSize="12.5" TextChanged="ShortcutSearchTextBox_OnTextChanged"
                                             automation:AutomationProperties.Name="Rechercher un raccourci"
                                             ToolTip="Rechercher par nom, description ou touche" />
                                    <ListBox x:Name="ShortcutListBox" Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="178" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFF0F1F3"
                                                                   FontSize="12.5" />
                                                        <TextBlock Text="{Binding Description}" Margin="0,2,8,0"
                                                                   Foreground="#FF7F8792" FontSize="10.5"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Height="34" Padding="10,0"
                                                            Style="{StaticResource TextButton}"
                                                            Content="{Binding DisplayGesture}" Tag="{Binding}"
                                                            ToolTip="Double-cliquez pour changer. Appuyez sur Échap ici pour désattribuer."
                                                            PreviewMouseDoubleClick="ShortcutGestureButton_OnMouseDoubleClick"
                                                            PreviewKeyDown="ShortcutGestureButton_OnPreviewKeyDown" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ShortcutEmptySearchText" Margin="0,12,0,2"
                                               Text="Aucun raccourci ne correspond à cette recherche."
                                               Foreground="#FF858C97" FontSize="11.5"
                                               HorizontalAlignment="Center" Visibility="Collapsed" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="RÉINITIALISER LES RACCOURCIS"
                                                       Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,16,0"
                                                       Text="Restaure tous les raccourcis par défaut de Fuze."
                                                       Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Réinitialiser"
                                                Style="{StaticResource TextButton}"
                                                VerticalAlignment="Center"
                                                Click="ResetShortcuts_OnClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,14" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="IGNORER LES TOUCHES DE VOLUME DU CLAVIER"
                                                   Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0"
                                                   Text="Fuze laisse alors Windows gérer Volume +, Volume − et Muet."
                                                   Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="IgnoreKeyboardVolumeButtonsCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#663C444F" BorderThickness="0,1,0,0"
                    Background="#8C141920"
                    CornerRadius="0,0,11,11"
                    ClipToBounds="True">
                <Grid Margin="20,0">
                    <Button Content="Tout réinitialiser" Style="{StaticResource TextButton}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Click="ResetDefaults_OnClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Annuler" Style="{StaticResource TextButton}"
                                Margin="0,0,8,0" Click="Cancel_OnClick" />
                        <Button Content="Enregistrer" Style="{StaticResource TextButton}"
                                Background="#FFFF8A42" BorderBrush="#FFFF8A42"
                                Foreground="#FF17100B" FontWeight="SemiBold"
                                Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

        <Grid x:Name="PriorityPromptOverlay" Panel.ZIndex="2000" Visibility="Collapsed">
            <Border Background="#B8000000" CornerRadius="12" />
            <Border Width="430" MaxWidth="560" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF171C24" BorderBrush="#FF4A535F"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="PriorityPromptTitleText" Text="Confirmation"
                               Foreground="#FFF4F5F7" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PriorityPromptMessageText" Margin="0,9,0,20"
                               Foreground="#FFADB4BE" FontSize="12.5" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PriorityPromptCancelButton" Content="Annuler"
                                Margin="0,0,8,0" Style="{StaticResource TextButton}"
                                Click="PriorityPromptCancel_OnClick" />
                        <Button x:Name="PriorityPromptConfirmButton" Content="Confirmer"
                                Style="{StaticResource TextButton}"
                                Background="#FFFF8A42" BorderBrush="#FFFF8A42"
                                Foreground="#FF17100B" FontWeight="SemiBold"
                                Click="PriorityPromptConfirm_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShortcutCaptureOverlay" Panel.ZIndex="2100" Visibility="Collapsed">
            <Border Background="#B8000000" CornerRadius="12" />
            <Border Width="470" MaxWidth="600" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF171C24" BorderBrush="#FF4A535F"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="ShortcutCaptureTitleText" Text="Modifier le raccourci"
                               Foreground="#FFF4F5F7" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,13"
                               Text="Appuyez sur une touche ou une combinaison. Échap choisit « Non attribué »."
                               Foreground="#FFADB4BE" FontSize="12" TextWrapping="Wrap" />
                    <Border x:Name="ShortcutCaptureKeyBorder" Height="56" Padding="12,0"
                            Background="#FF0C1016" BorderBrush="#FFFF8A42"
                            BorderThickness="1" CornerRadius="8" Focusable="True"
                            PreviewKeyDown="ShortcutCaptureKeyBorder_OnPreviewKeyDown">
                        <TextBlock x:Name="ShortcutCaptureKeyText" Text="Appuyez sur une touche…"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFF4F5F7" FontFamily="Cascadia Mono"
                                   FontSize="15" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="ShortcutCaptureErrorText" Margin="0,8,0,0"
                               Foreground="#FFFF7B86" FontSize="11.5" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Margin="0,0,8,0"
                                Style="{StaticResource TextButton}" Click="ShortcutCaptureCancel_OnClick" />
                        <Button Content="Affecter" Style="{StaticResource TextButton}"
                                Background="#FFFF8A42" BorderBrush="#FFFF8A42"
                                Foreground="#FF17100B" FontWeight="SemiBold"
                                Click="ShortcutCaptureApply_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
