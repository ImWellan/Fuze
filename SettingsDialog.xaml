                                                           Text="0 / 50 • priorité du haut vers le bas"
                                                           Foreground="#FF7F8792" FontSize="10.5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="MergeSubtitlePrioritiesIntoAudioButton" Content="⇄"
                                                        Margin="0,0,6,0" ToolTip="Intégrer la liste des sous-titres"
                                                        Style="{StaticResource PriorityIconButton}"
                                                        Click="MergeSubtitlePrioritiesIntoAudio_OnClick" />
                                                <Button Content="↺" Margin="0,0,6,0" ToolTip="Vider la liste audio"
                                                        Style="{StaticResource PriorityIconButton}"
                                                        Click="ClearAudioPriorities_OnClick" />
                                                <Button x:Name="AddAudioPriorityButton" Content="+" ToolTip="Ajouter un titre audio"
                                                        Style="{StaticResource PriorityIconButton}"
                                                        Click="AddAudioPriority_OnClick" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,7,0,7"
                                                   Text="Saisissez le titre exact ou une partie du titre. Maintenez la poignée ≡ pour changer l’ordre."
                                                   Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        <ListBox x:Name="PreferredAudioTitlesListBox" MinHeight="42" MaxHeight="230"
                                                 AllowDrop="True" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Drop="PriorityListBox_OnDrop" DragOver="PriorityListBox_OnDragOver"
                                                 automation:AutomationProperties.Name="Priorités audio personnalisées">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,6" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="PriorityItemBorder" Padding="5" Background="#82171C24" BorderBrush="#663D4550"
                                                            BorderThickness="1" CornerRadius="7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="38" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="26" Background="Transparent"
                                                                    Cursor="Arrow" ToolTip="Maintenir et déplacer"
                                                                    PreviewMouseLeftButtonDown="PriorityDragHandle_OnPreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="PriorityDragHandle_OnPreviewMouseMove">
                                                                <TextBlock Text="≡" Foreground="#FF8E96A1" FontSize="18"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PriorityTextBox}"
                                                                     automation:AutomationProperties.Name="Titre audio prioritaire" />
                                                            <Button Grid.Column="2" Content="−" ToolTip="Retirer"
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource PriorityIconButton}"
                                                                    Click="RemovePriority_OnClick" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                            <Setter TargetName="PriorityItemBorder" Property="Background" Value="#66351F18" />
                                                            <Setter TargetName="PriorityItemBorder" Property="BorderBrush" Value="#FFFF8A42" />
                                                            <Setter TargetName="PriorityItemBorder" Property="BorderThickness" Value="1" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DecodedAudioControls" Margin="0,14,0,0" Padding="18,15"
                                    Background="#9C0D1117" BorderBrush="#663C444F"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="CANAUX ET TRAITEMENTS PAR DÉFAUT" TextOptions.TextFormattingMode="Display"
                                               Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Ces réglages sont partagés avec les choix rapides de l’onglet Audio."
                                               Foreground="#FF8E96A1" FontSize="11" />
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="Mode de canaux audio" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Définit le traitement audio appliqué par défaut."
                                                       Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="AudioOutputModeComboBox" Grid.Column="1"
                                                  VerticalAlignment="Center" Style="{StaticResource SettingsComboBox}"
                                                  automation:AutomationProperties.Name="Mode de canaux audio par défaut">
                                            <ComboBoxItem Content="Automatique (original)" Tag="{x:Static playback:AudioOutputMode.Automatic}" />
                                            <ComboBoxItem Content="Mono" Tag="{x:Static playback:AudioOutputMode.Mono}" />
                                            <ComboBoxItem Content="Stéréo" Tag="{x:Static playback:AudioOutputMode.Stereo}" />
                                            <ComboBoxItem Content="Canal gauche" Tag="{x:Static playback:AudioOutputMode.LeftChannel}" />
                                            <ComboBoxItem Content="Canal droit" Tag="{x:Static playback:AudioOutputMode.RightChannel}" />
                                            <ComboBoxItem Content="Stéréo inversée" Tag="{x:Static playback:AudioOutputMode.ReversedStereo}" />
                                        </ComboBox>
                                    </Grid>
                                    <UniformGrid Margin="0" Columns="2" Rows="2">
                                        <CheckBox x:Name="NightModeCheckBox" Margin="0,0,10,9"
                                                  Content="Mode nuit" Foreground="#FFF0F1F3"
                                                  Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="DialogueBoostCheckBox" Margin="0,0,0,9"
                                                  Content="Dialogues renforcés" Foreground="#FFF0F1F3"
                                                  Style="{StaticResource SettingsToggleWithText}" />
                                        <CheckBox x:Name="HeadphoneBinauralCheckBox" Margin="0,0,10,0"
                                                  Content="Casque binaural" Foreground="#FFF0F1F3"
                                                  Style="{StaticResource SettingsToggleWithText}"
                                                  Checked="TreatmentCheckBox_OnChanged" />
                                        <CheckBox x:Name="SurroundDownmixCheckBox"
                                                  Content="Surround vers stéréo" Foreground="#FFF0F1F3"
                                                  Style="{StaticResource SettingsToggleWithText}"
                                                  Checked="TreatmentCheckBox_OnChanged" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NORMALISATION DU VOLUME" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0" Text="Réduit les écarts de volume entre les différents fichiers vidéo."
                                                   Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="AudioNormalizationCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DÉLAI AUDIO PAR DÉFAUT" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0" Text="Valeur négative : audio avancé. Valeur positive : audio retardé."
                                                   Foreground="#FF9EA5AF" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="AudioDelayTextBox" Width="94"
                                                 Style="{StaticResource SettingsTextBox}"
                                                 automation:AutomationProperties.Name="Délai audio par défaut en millisecondes" />
                                        <TextBlock Text="ms" Margin="0,0,10,0" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="#FF858C97"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MODE EXCLUSIF WASAPI" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0"
                                                   Text="Utilise la sortie WASAPI en accès direct : Fuze contourne le mélangeur Windows et envoie le signal au périphérique avec moins de traitements et parfois moins de latence. Pendant la lecture, les autres applications peuvent ne plus pouvoir utiliser ce périphérique; si le matériel ne prend pas ce mode en charge, la sortie normale est utilisée."
                                                   Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="AudioExclusiveCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              automation:AutomationProperties.Name="Activer le mode exclusif WASAPI" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,14" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PASSTHROUGH HDMI / S/PDIF" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0"
                                                   Text="Transmet Dolby ou DTS directement à un appareil compatible. Les canaux et traitements audio sont alors désactivés."
                                                   Foreground="#FF9EA5AF" FontSize="11.2" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="AudioPassthroughCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              Checked="AudioPassthroughCheckBox_OnChanged"
                                              Unchecked="AudioPassthroughCheckBox_OnChanged"
                                              automation:AutomationProperties.Name="Activer le passthrough audio" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="VideoPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="VIDÉO" Foreground="#FFF4F5F7"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,17"
                                       Text="Écran, moteur de sortie et captures d’écran."
                                       Foreground="#FFA7ADB6" FontSize="12.5" />

                            <Border Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OUVERTURE EN PLEIN ÉCRAN"
                                                   Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,14,0"
                                                   Text="Passe automatiquement en plein écran lorsqu’un fichier vidéo démarre."
                                                   Foreground="#FF9EA5AF" FontSize="11.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="StartVideoFullscreenCheckBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsToggle}"
                                              automation:AutomationProperties.Name="Ouvrir automatiquement les vidéos en plein écran" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="PÉRIPHÉRIQUE D’AFFICHAGE" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Choisit l’écran sur lequel Fuze place la fenêtre avant de démarrer la vidéo."
                                                   Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="VideoDisplayComboBox" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource SettingsComboBox}"
                                              automation:AutomationProperties.Name="Écran de démarrage des vidéos" />
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="SORTIE VIDÉO" Foreground="#FFFF9A48"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Le changement du moteur est appliqué au prochain démarrage de Fuze."
                                                   Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="VideoOutputComboBox" Grid.Column="1"
                                              VerticalAlignment="Center" Style="{StaticResource SettingsComboBox}"
                                              automation:AutomationProperties.Name="Moteur de sortie vidéo">
                                        <ComboBoxItem Content="Automatique (recommandé)" Tag="auto" />
                                        <ComboBoxItem Content="Direct3D 11" Tag="d3d11" />
                                        <ComboBoxItem Content="Direct3D 9 (ANGLE, compatibilité)" Tag="d3d9" />
                                        <ComboBoxItem Content="OpenGL" Tag="opengl" />
                                        <ComboBoxItem Content="Windows GDI / logiciel (WARP)" Tag="software"
                                                      ToolTip="Rendu logiciel Windows de secours; libmpv moderne utilise WARP plutôt que GDI." />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="ZOOM VIDÉO" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Définit la valeur utilisée par l’option Zoom personnalisé dans le menu Vidéo."
                                               Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Zoom personnalisé" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Valeur comprise entre 50 et 1 000 %."
                                                       Foreground="#FF7F8792" FontSize="10.5" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="94" VerticalAlignment="Center">
                                            <TextBox x:Name="CustomZoomPercentTextBox"
                                                     Width="94" Padding="10,0,28,0"
                                                     TextAlignment="Center"
                                                     Style="{StaticResource SettingsTextBox}"
                                                     automation:AutomationProperties.Name="Zoom vidéo personnalisé en pourcentage" />
                                            <TextBlock Text="%" Margin="0,0,10,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="#FF858C97" IsHitTestVisible="False" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="FORMAT D’IMAGE PERSONNALISÉ" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10"
                                               Text="Définit le format utilisé par l’option Personnaliser dans le menu Format d’image."
                                               Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Format personnalisé" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Écrivez un ratio comme 16:9 ou 21:9."
                                                       Foreground="#FF7F8792" FontSize="10.5" />
                                        </StackPanel>
                                        <TextBox x:Name="CustomAspectRatioTextBox" Grid.Column="1"
                                                 Width="112" Height="38" Padding="8,0"
                                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                                 Style="{StaticResource SettingsTextBox}"
                                                 automation:AutomationProperties.Name="Format d’image personnalisé" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="18,14" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="DÉCODAGE ET IMAGE" Foreground="#FFFF9A48" FontSize="12" FontWeight="SemiBold" />
                                    <StackPanel x:Name="HardwareDecodingSettingBlock">
                                    <Grid MinHeight="70" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Décodage matériel" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Confie la décompression des images au GPU (H.264, H.265, AV1, etc.) pour réduire l’utilisation du processeur. Peut améliorer la fluidité, mais certains pilotes ou formats peuvent être incompatibles : désactivez cette option si vous voyez des artefacts ou des plantages." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="HardwareDecodingCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    </StackPanel>
                                    <Grid MinHeight="70">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Désentrelacement" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Text="Transforme une source entrelacée (TV, DVD ou ancien caméscope) en images progressives pour supprimer les effets de peigne et les lignes visibles en mouvement. Sans effet sur une vidéo déjà progressive et peut demander un peu plus de ressources." Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="DeinterlacingCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsToggle}" />
                                    </Grid>
                                    <Border Height="1" Margin="0,5" Background="#543C444F" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="HDR et gestion des couleurs" Foreground="#FFF0F1F3" FontSize="12.5" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="Choisit le traitement HDR et la gestion des couleurs de la vidéo."
                                                       Foreground="#FF7F8792" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="HdrModeComboBox" Grid.Column="1" VerticalAlignment="Center"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  automation:AutomationProperties.Name="Mode HDR et couleurs">
                                            <ComboBoxItem Content="Automatique (recommandé)" Tag="auto" />
                                            <ComboBoxItem Content="Activé" Tag="yes" />
                                            <ComboBoxItem Content="Désactivé" Tag="no" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,14" Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="CAPTURES D’ÉCRAN" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,12"
                                               Text="Emplacement et nom utilisés par le bouton de capture et le raccourci S."
                                               Foreground="#FF8E96A1" FontSize="11" TextWrapping="Wrap" />

                                    <TextBlock Text="Emplacement de base" Foreground="#FFF0F1F3" FontSize="12" />
                                    <Grid Margin="0,6,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScreenshotBaseDirectoryTextBox"
                                                 Style="{StaticResource PriorityTextBox}"
                                                 automation:AutomationProperties.Name="Dossier de base des captures" />
