<Window x:Class="FusePlayer.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:playback="clr-namespace:FusePlayer.Playback"
        Title="Paramètres"
        Width="760"
        Height="650"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6,29,6" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FF0C1016" />
            <Setter Property="Foreground" Value="#FFF4F5F7" />
            <Setter Property="BorderBrush" Value="#FF3D4550" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFF8A42" />
            <Setter Property="SelectionBrush" Value="#88FF7A45" />
            <Setter Property="SelectionTextBrush" Value="#FFF4F5F7" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="PriorityTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FF0C1016" />
            <Setter Property="Foreground" Value="#FFF4F5F7" />
            <Setter Property="BorderBrush" Value="#FF3D4550" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFF8A42" />
            <Setter Property="SelectionBrush" Value="#88FF7A45" />
            <Setter Property="SelectionTextBrush" Value="#FFF4F5F7" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PriorityIconButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BottomBarLayoutListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE8EBEF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF3A2A20" />
                                <Setter Property="Foreground" Value="#FFFFB276" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF252B34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BottomBarLayoutItemTemplate">
            <TextBlock Text="{Binding Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border x:Name="Track" Height="24" VerticalAlignment="Center"
                                    Background="#FF343B45" BorderBrush="#FF4A535F"
                                    BorderThickness="1" CornerRadius="12" />
                            <Ellipse x:Name="Knob" Width="18" Height="18" Margin="4,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="#FFD9DCE1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF737C88" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FFFF7A45" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFF9B70" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FF17100B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggleWithText" TargetType="CheckBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Foreground" Value="#FFF0F1F3" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="32" Height="18" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="#FF343B45"
                                    BorderBrush="#FF4A535F" BorderThickness="1" CornerRadius="9">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="#FFD9DCE1" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF737C88" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FFFF7A45" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFF9B70" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FF17100B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsItemTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#FFF0F1F3" />
        </Style>

        <Style x:Key="SettingsItemDescription" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF7F8792" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#FFC4C9D0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BackgroundBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#36FF7A45" />
                                <Setter Property="Foreground" Value="#FFFFA578" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FF0C1016" />
            <Setter Property="Foreground" Value="#FFF1F2F4" />
            <Setter Property="BorderBrush" Value="#FF3D4550" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                        <Grid Height="{TemplateBinding Height}">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          Height="{TemplateBinding Height}"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Cursor="Arrow">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="#FF0C1016"
                                                BorderBrush="#FF3D4550" BorderThickness="1"
                                                CornerRadius="7"
                                                Height="{TemplateBinding Height}"
                                                VerticalAlignment="Stretch">
                                            <Grid Margin="12,0,10,0">
                                                <ContentPresenter Margin="0,0,28,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#FFF1F2F4" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M 0 0 L 5 5 L 10 0" Stroke="#FFAEB4BD"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF707986" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FFFF8A42" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="270" Padding="4" Background="#FF171C24"
                                        BorderBrush="#FF4B5460" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFF1F2F4" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#36FF7A45" />
                                <Setter Property="Foreground" Value="#FFFFB187" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boutons de défilement Fuse : le thème Windows ne doit jamais
             remplacer le fond par un survol bleu. -->
        <Style x:Key="DialogScrollBarRepeatButton" TargetType="RepeatButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="RepeatButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF2B3038" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF343B45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource FuzeScrollBarContextMenuHostStyle}">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="#FF14171B" />
            <Setter Property="Foreground" Value="#FF60656D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="11" Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="13" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#FF20242A" BorderThickness="0" Focusable="False"
                                          Style="{StaticResource DialogScrollBarRepeatButton}">
                                <Path Data="M 0,3 L 2.5,0.5 L 5,3" Width="5" Height="3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <Track x:Name="PART_Track" Grid.Row="1" Width="11"
                                   HorizontalAlignment="Center" IsDirectionReversed="True"
                                   ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0" Focusable="False"
                                                  Style="{StaticResource DialogScrollBarRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="6" MinHeight="28" Margin="0,1"
                                           HorizontalAlignment="Center" ClipToBounds="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ScrollThumb" Background="#FF555A62" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ScrollThumb" Property="Background" Value="#FF707782" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ScrollThumb" Property="Background" Value="#FFFF8A42" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0" Focusable="False"
                                                  Style="{StaticResource DialogScrollBarRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#FF20242A" BorderThickness="0" Focusable="False"
                                          Style="{StaticResource DialogScrollBarRepeatButton}">
                                <Path Data="M 0,0 L 2.5,2.5 L 5,0" Width="5" Height="3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" ClipToBounds="True">
    <Border Background="#F2171C24" BorderBrush="#FF3D444F"
            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="18,0,8,0" Text="PARAMÈTRES"
                               Foreground="#FFF4F5F7" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button Grid.Column="1" Width="44" Height="42"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;" ToolTip="Enregistrer et fermer" Click="Save_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A60F141B"
                        BorderBrush="#663C444F" BorderThickness="0,0,1,0">
                    <StackPanel Margin="13,18,13,0">
                        <TextBlock Margin="10,0,0,8" Text="CATÉGORIES"
                                   Foreground="#FF777F8B" FontSize="10.5"
                                   FontWeight="SemiBold" />
                        <ListBox x:Name="CategoryList" SelectedIndex="0"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CategoryItem}"
                                 SelectionChanged="CategoryList_OnSelectionChanged">
                            <ListBoxItem Content="Général" Tag="General" />
                            <ListBoxItem Content="Système" Tag="System" />
                            <ListBoxItem Content="Média" Tag="Media" />
                            <ListBoxItem Content="Interface" Tag="Interface" />
                            <ListBoxItem Content="Vidéo" Tag="Video" />
                            <ListBoxItem Content="Audio" Tag="Audio" />
                            <ListBoxItem Content="Sous-titres" Tag="Subtitles" />
                            <ListBoxItem Content="Raccourcis" Tag="Shortcuts" />
                        </ListBox>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="24,19,24,0">
                    <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="GÉNÉRAL" Foreground="#FFF4F5F7"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,17"
                                       Text="Lecture, navigation et comportement de lecture."
                                       Foreground="#FFA7ADB6" FontSize="12.5" />

                            <Border Padding="18,15" Background="#9C0D1117"
                                    BorderBrush="#663C444F" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="78" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="68" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SAUTS DE LECTURE" Foreground="#FFFF9A48"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Margin="0,3,0,0"
                                               Text="Durée utilisée par les boutons de retour et d’avance."
                                               Foreground="#FF9EA5AF" FontSize="11.5" />
                                    <Grid Grid.Row="2" Margin="0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Retour en arrière" Foreground="#FFF0F1F3" FontSize="12.5" />
                                                <TextBlock Text="Défaut : 15 s" Foreground="#FF7F8792" FontSize="10.5" />
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <TextBox x:Name="RewindTextBox" Style="{StaticResource SettingsTextBox}"
                                                         automation:AutomationProperties.Name="Durée du retour en arrière" />
                                                <TextBlock Text="s" Margin="0,0,11,0" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="#FF858C97"
                                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Avance rapide" Foreground="#FFF0F1F3" FontSize="12.5" />
                                                <TextBlock Text="Défaut : 30 s" Foreground="#FF7F8792" FontSize="10.5" />
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <TextBox x:Name="ForwardTextBox" Style="{StaticResource SettingsTextBox}"
                                                         automation:AutomationProperties.Name="Durée de l’avance rapide" />
                                                <TextBlock Text="s" Margin="0,0,11,0" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="#FF858C97"
                                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Row="3" Background="#543C444F" />
                                    <Grid Grid.Row="4" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Priorité aux chapitres" Foreground="#FFF0F1F3" FontSize="13" />
                                            <TextBlock Margin="0,2,14,0"
                                                       Text="Précédent et Suivant changent d’abord de chapitre, puis de média."
