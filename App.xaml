<Application x:Class="FusePlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Fuze conserve la flèche système partout; les survols signalent les actions. -->
            <Style TargetType="Window">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="ForceCursor" Value="True" />
            </Style>

            <Color x:Key="InkColor">#FFF4F5F7</Color>
            <Color x:Key="MutedColor">#FF8C929F</Color>
            <Color x:Key="SurfaceColor">#FF11151C</Color>
            <Color x:Key="SurfaceRaisedColor">#FF171C24</Color>
            <Color x:Key="BorderColor">#FF282E38</Color>
            <Color x:Key="AccentColor">#FFFF7A45</Color>

            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#FF202630" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="ToolTipService.Placement" Value="Top" />
                <Setter Property="ToolTipService.VerticalOffset" Value="6" />
                <Setter Property="ToolTipService.ShowDuration" Value="10000" />
                <EventSetter Event="Opened" Handler="ToolTip_OnOpened" />
                <EventSetter Event="Closed" Handler="ToolTip_OnClosed" />
            </Style>

            <!-- Remplace les RepeatButton natifs des barres de défilement :
                 le thème Windows ajoutait un survol bleu dans les listes Fuse. -->
            <Style x:Key="FuzeScrollBarRepeatButton" TargetType="RepeatButton">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="RepeatButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ContentSource="Content" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF2B3038" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF343B45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#20FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#32FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseWindowButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseButtonBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseButtonBackground"
                                            Property="Background" Value="#FFE24A50" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CloseButtonBackground"
                                            Property="Background" Value="#FFB83238" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Les fenêtres secondaires gardent une zone de clic confortable,
                 mais le fond rouge du X demeure plus petit que la case du titre,
                 comme dans « À propos de Fuze ». -->
            <Style x:Key="DialogCloseWindowButton" TargetType="Button"
                   BasedOn="{StaticResource CloseWindowButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="CloseButtonBackground"
                                        Width="34" Height="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseButtonBackground"
                                            Property="Background" Value="#FFE24A50" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CloseButtonBackground"
                                            Property="Background" Value="#FFB83238" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="ChapterMarkerButton" TargetType="Button">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}"
                                  SnapsToDevicePixels="True">
                                <Rectangle x:Name="ChapterStem"
                                           Width="1" Height="9"
                                           VerticalAlignment="Bottom"
                                           Fill="#7AD7D9DE"
                                           IsHitTestVisible="False" />
                                <Border x:Name="ChapterDiamond"
                                        Width="6" Height="6"
                                        Margin="0,1,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="#FF252830"
                                        BorderBrush="#FFE4E5E8"
                                        BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChapterDiamond" Property="BorderBrush" Value="#FFFF555D" />
                                    <Setter TargetName="ChapterStem" Property="Fill" Value="#CCFF555D" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ChapterDiamond" Property="Background" Value="#FFFF555D" />
                                    <Setter TargetName="ChapterDiamond" Property="BorderBrush" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TextButton" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#24FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#36FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FuzeContextMenuItemStyle" TargetType="MenuItem">
                <Setter Property="MinWidth" Value="230" />
                <Setter Property="Height" Value="35" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Foreground" Value="#FFF4F4F4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBackground"
                                    Margin="0,1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark"
                                               Grid.Column="0"
                                               Text="✓"
                                               Foreground="#FFFF8A65"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1"
                                                      Margin="7,0,18,0"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{TemplateBinding InputGestureText}"
                                               Foreground="#FFB4B8BE"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="#32FF704D" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="ItemBackground" Property="Background" Value="#32FF704D" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FuzeContextMenuSeparatorStyle" TargetType="Separator">
                <Setter Property="Height" Value="9" />
                <Setter Property="Margin" Value="9,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1"
                                    VerticalAlignment="Center"
                                    Background="#80515860" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FuzeContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="#F523262B" />
                <Setter Property="Foreground" Value="#FFF4F4F4" />
                <Setter Property="BorderBrush" Value="#B24B5159" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource FuzeContextMenuItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="4"
                                                      Color="#FF000000"
                                                      Opacity="0.5" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Menu explicite des barres de défilement. Le menu natif Windows est
                 remplacé uniquement pour ces contrôles afin d'éviter les conflits
                 avec le gabarit WPF du menu contextuel. -->
            <ContextMenu x:Key="FuzeScrollBarContextMenu" x:Shared="False"
                         Style="{StaticResource FuzeContextMenuStyle}">
                <MenuItem Header="Défiler d’une ligne vers le haut"
                          Style="{StaticResource FuzeContextMenuItemStyle}"
                          Command="{x:Static ScrollBar.LineUpCommand}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                <MenuItem Header="Défiler d’une page vers le haut"
                          Style="{StaticResource FuzeContextMenuItemStyle}"
                          Command="{x:Static ScrollBar.PageUpCommand}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                <Separator Style="{StaticResource FuzeContextMenuSeparatorStyle}" />
                <MenuItem Header="Défiler d’une page vers le bas"
                          Style="{StaticResource FuzeContextMenuItemStyle}"
                          Command="{x:Static ScrollBar.PageDownCommand}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                <MenuItem Header="Défiler d’une ligne vers le bas"
                          Style="{StaticResource FuzeContextMenuItemStyle}"
                          Command="{x:Static ScrollBar.LineDownCommand}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
            </ContextMenu>

            <Style x:Key="FuzeScrollBarContextMenuHostStyle" TargetType="ScrollBar">
                <Setter Property="ContextMenu" Value="{StaticResource FuzeScrollBarContextMenu}" />
            </Style>
            <Style x:Key="FuzeScrollBar" TargetType="ScrollBar"
                   BasedOn="{StaticResource FuzeScrollBarContextMenuHostStyle}">
                <Setter Property="Width" Value="11" />
                <Setter Property="Background" Value="#FF14171B" />
                <Setter Property="Foreground" Value="#FF60656D" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Width="11" Background="{TemplateBinding Background}"
                                  SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="13" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="13" />
                                </Grid.RowDefinitions>
                                <RepeatButton Grid.Row="0"
                                              Command="{x:Static ScrollBar.LineUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="#FF20242A" BorderThickness="0"
                                              Style="{StaticResource FuzeScrollBarRepeatButton}">
                                    <Path Data="M 0,3 L 2.5,0.5 L 5,3" Width="5" Height="3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Row="1" Width="11"
                                       HorizontalAlignment="Center" IsDirectionReversed="True"
                                       ClipToBounds="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Background="Transparent" BorderThickness="0"
                                                      Style="{StaticResource FuzeScrollBarRepeatButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="6" MinHeight="28" Margin="0,1"
                                               HorizontalAlignment="Center" ClipToBounds="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF555A62"
                                                    CornerRadius="3"
                                                            ClipToBounds="False"
                                                            SnapsToDevicePixels="True" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Background="Transparent" BorderThickness="0"
                                                      Style="{StaticResource FuzeScrollBarRepeatButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Row="2"
                                              Command="{x:Static ScrollBar.LineDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="#FF20242A" BorderThickness="0"
                                              Style="{StaticResource FuzeScrollBarRepeatButton}">
                                    <Path Data="M 0,0 L 2.5,2.5 L 5,0" Width="5" Height="3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar"
                   BasedOn="{StaticResource FuzeScrollBar}" />

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="#3DFFFFFF" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" VerticalAlignment="Center">
                                <Track x:Name="PART_Track" Height="14">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Background="{TemplateBinding Foreground}"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="{TemplateBinding Background}"
                                                            CornerRadius="2" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Background="{TemplateBinding Background}"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="{TemplateBinding Background}"
                                                            CornerRadius="2" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="13" Height="13" Cursor="Arrow">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="#FFF8F9FA" Stroke="#55FFFFFF" StrokeThickness="1">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.4" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
