<Window x:Class="FusePlayer.TrackSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synchronisation des pistes"
        Width="690" Height="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#F2171C24"
            BorderBrush="#CC3D444F"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="58" />
                <RowDefinition x:Name="VideoRow" Height="116" />
                <RowDefinition x:Name="AudioRow" Height="116" />
                <RowDefinition x:Name="SubtitleRow" Height="116" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DialogTitleText" Margin="17,0,8,0"
                               Text="Synchronisation des pistes"
                               Foreground="#FFF4F5F7"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <Button Grid.Column="1"
                            Width="42" Height="42"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fermer"
                            Click="Close_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,10,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IntroText" Text="Ajustement en temps réel pendant la lecture"
                           Foreground="#FFE3E5E8" FontSize="13.5"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,7,0" Padding="7,3"
                            Background="#5CFFFFFF" CornerRadius="9"
                            ToolTipService.Placement="Top"
                            ToolTip="Une valeur négative fait arriver la piste plus tôt.">
                        <TextBlock Text="−  avancé"
                                   Foreground="#FFD2D6DC" FontSize="12" />
                    </Border>
                    <Border Padding="7,3"
                            Background="#5CFFFFFF" CornerRadius="9"
                            ToolTipService.Placement="Top"
                            ToolTip="Une valeur positive fait arriver la piste plus tard.">
                        <TextBlock Text="+  retardé"
                                   Foreground="#FFD2D6DC" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="VideoSection" Grid.Row="2" Margin="20,5,20,5"
                    Background="#8C0D1117" BorderBrush="#663C444F"
                    BorderThickness="1" CornerRadius="9">
                <Grid Margin="14,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VIDÉO" Foreground="#FFFF9A48"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="•" Grid.Column="1" Margin="10,0"
                                   Foreground="#FFF4F5F7" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="VideoTrackText" Grid.Column="2"
                                   Foreground="#FFC5CAD1" FontSize="12.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="−100 ms" Tag="Video:-100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Avancer la vidéo de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" Margin="0,0,8,0" />
                            <Grid Width="88" Height="38" Margin="0,0,8,0">
                            <TextBox x:Name="VideoValueTextBox" Tag="Video"
                                     AutomationProperties.Name="Décalage vidéo en millisecondes"
                                      Width="88" Height="38" Padding="2"
                                     Background="#FF090D13" Foreground="#FFF4F5F7"
                                     BorderBrush="#FF3A414C" BorderThickness="1"
                                     CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                                     FontFamily="Cascadia Mono" FontSize="14"
                                      TextAlignment="Center" VerticalContentAlignment="Center"
                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                     PreviewTextInput="ValueTextBox_OnPreviewTextInput"
                                     LostKeyboardFocus="ValueTextBox_OnLostKeyboardFocus"
                                     PreviewKeyDown="ValueTextBox_OnPreviewKeyDown" />
                            <TextBlock Text="ms" Margin="0,0,7,0" Foreground="#FFB8BDC5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            </Grid>
                            <Button Content="+100 ms" Tag="Video:100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Retarder la vidéo de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Réinitialiser" Tag="Video" Click="ResetRowButton_OnClick"
                                AutomationProperties.Name="Réinitialiser la vidéo"
                                Style="{StaticResource TextButton}" Height="30"
                                HorizontalAlignment="Left" Margin="8,0,0,0" />
                    </Grid>
                    <Slider x:Name="VideoSlider" Grid.Row="2" Tag="Video"
                            AutomationProperties.Name="Curseur de synchronisation vidéo"
                            Minimum="-30000" Maximum="30000"
                            SmallChange="50" LargeChange="500" TickFrequency="50"
                            IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_OnValueChanged" />
                </Grid>
            </Border>

            <Border x:Name="AudioSection" Grid.Row="3" Margin="20,5,20,5"
                    Background="#8C0D1117" BorderBrush="#663C444F"
                    BorderThickness="1" CornerRadius="9">
                <Grid Margin="14,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AUDIO" Foreground="#FFFF9A48"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="•" Grid.Column="1" Margin="10,0"
                                   Foreground="#FFF4F5F7" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="AudioTrackText" Grid.Column="2"
                                   Foreground="#FFC5CAD1" FontSize="12.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="−100 ms" Tag="Audio:-100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Avancer l’audio de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" Margin="0,0,8,0" />
                            <Grid Width="88" Height="38" Margin="0,0,8,0">
                            <TextBox x:Name="AudioValueTextBox" Tag="Audio"
                                     AutomationProperties.Name="Décalage audio en millisecondes"
                                      Width="88" Height="38" Padding="2"
                                     Background="#FF090D13" Foreground="#FFF4F5F7"
                                     BorderBrush="#FF3A414C" BorderThickness="1"
                                     CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                                     FontFamily="Cascadia Mono" FontSize="14"
                                      TextAlignment="Center" VerticalContentAlignment="Center"
                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                     PreviewTextInput="ValueTextBox_OnPreviewTextInput"
                                     LostKeyboardFocus="ValueTextBox_OnLostKeyboardFocus"
                                     PreviewKeyDown="ValueTextBox_OnPreviewKeyDown" />
                            <TextBlock Text="ms" Margin="0,0,7,0" Foreground="#FFB8BDC5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            </Grid>
                            <Button Content="+100 ms" Tag="Audio:100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Retarder l’audio de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Réinitialiser" Tag="Audio" Click="ResetRowButton_OnClick"
                                AutomationProperties.Name="Réinitialiser l’audio"
                                Style="{StaticResource TextButton}" Height="30"
                                HorizontalAlignment="Left" Margin="8,0,0,0" />
                    </Grid>
                    <Slider x:Name="AudioSlider" Grid.Row="2" Tag="Audio"
                            AutomationProperties.Name="Curseur de synchronisation audio"
                            Minimum="-30000" Maximum="30000"
                            SmallChange="50" LargeChange="500" TickFrequency="50"
                            IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_OnValueChanged" />
                </Grid>
            </Border>

            <Border x:Name="SubtitleSection" Grid.Row="4" Margin="20,5,20,5"
                    Background="#8C0D1117" BorderBrush="#663C444F"
                    BorderThickness="1" CornerRadius="9">
                <Grid Margin="14,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SOUS-TITRES" Foreground="#FFFF9A48"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="•" Grid.Column="1" Margin="10,0"
                                   Foreground="#FFF4F5F7" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="SubtitleTrackText" Grid.Column="2"
                                   Foreground="#FFC5CAD1" FontSize="12.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="−100 ms" Tag="Subtitle:-100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Avancer les sous-titres de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" Margin="0,0,8,0" />
                            <Grid Width="88" Height="38" Margin="0,0,8,0">
                            <TextBox x:Name="SubtitleValueTextBox" Tag="Subtitle"
                                     AutomationProperties.Name="Décalage des sous-titres en millisecondes"
                                      Width="88" Height="38" Padding="2"
                                     Background="#FF090D13" Foreground="#FFF4F5F7"
                                     BorderBrush="#FF3A414C" BorderThickness="1"
                                     CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                                     FontFamily="Cascadia Mono" FontSize="14"
                                      TextAlignment="Center" VerticalContentAlignment="Center"
                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                     PreviewTextInput="ValueTextBox_OnPreviewTextInput"
                                     LostKeyboardFocus="ValueTextBox_OnLostKeyboardFocus"
                                     PreviewKeyDown="ValueTextBox_OnPreviewKeyDown" />
                            <TextBlock Text="ms" Margin="0,0,7,0" Foreground="#FFB8BDC5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            </Grid>
                            <Button Content="+100 ms" Tag="Subtitle:100" Click="StepButton_OnClick"
                                    AutomationProperties.Name="Retarder les sous-titres de 100 millisecondes"
                                    Style="{StaticResource TextButton}" Height="30" Width="78" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Réinitialiser" Tag="Subtitle" Click="ResetRowButton_OnClick"
                                AutomationProperties.Name="Réinitialiser les sous-titres"
                                Style="{StaticResource TextButton}" Height="30"
                                HorizontalAlignment="Left" Margin="8,0,0,0" />
                    </Grid>
                    <Slider x:Name="SubtitleSlider" Grid.Row="2" Tag="Subtitle"
                            AutomationProperties.Name="Curseur de synchronisation des sous-titres"
                            Minimum="-30000" Maximum="30000"
                            SmallChange="50" LargeChange="500" TickFrequency="50"
                            IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_OnValueChanged" />
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="20,5,20,4" Padding="10,0"
                    Background="#6624272B" CornerRadius="7">
                <TextBlock x:Name="EffectiveDelayText"
                           Foreground="#FFC4C9D0" FontFamily="Cascadia Mono"
                           FontSize="12" VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>

            <Grid Grid.Row="6" Margin="20,8,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetAllButton" Content="Tout réinitialiser"
                        Style="{StaticResource TextButton}"
                        HorizontalAlignment="Left"
                        Click="ResetAll_OnClick" />
                <Button Grid.Column="1" Content="Fermer"
                        Style="{StaticResource TextButton}"
                        Background="#FFFF7A45" BorderBrush="#FFFF7A45"
                        Foreground="#FF120B07" FontWeight="SemiBold"
                        Click="Close_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
