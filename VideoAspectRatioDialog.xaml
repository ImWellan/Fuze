<Window x:Class="FusePlayer.VideoAspectRatioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format d’image personnalisé"
        Width="500" Height="300"
        MinWidth="450" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="17,0,8,0"
                               Text="Format d’image personnalisé"
                               Foreground="#FFF4F5F7"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <Button Grid.Column="1" Width="42" Height="42"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;" ToolTip="Fermer"
                            Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="22,16,22,12"
                       Text="Saisissez la largeur et la hauteur du format, par exemple 16:9 ou 21:9."
                       Foreground="#FFC7CBD1" FontSize="12.5" />

            <Grid Grid.Row="2" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WidthTextBox" Grid.Column="0"
                         Height="40" Padding="8,5"
                         Background="#FF0D1117" Foreground="#FFF4F5F7"
                         BorderBrush="#FF3A414C" BorderThickness="1"
                         CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                         FontFamily="Cascadia Mono" FontSize="19"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         MaxLength="5"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged"
                         AutomationProperties.Name="Largeur du format d’image" />
                <TextBlock Grid.Column="1" Text=":" Foreground="#FFD8DBDF"
                           FontFamily="Cascadia Mono" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBox x:Name="HeightTextBox" Grid.Column="2"
                         Height="40" Padding="8,5"
                         Background="#FF0D1117" Foreground="#FFF4F5F7"
                         BorderBrush="#FF3A414C" BorderThickness="1"
                         CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                         FontFamily="Cascadia Mono" FontSize="19"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         MaxLength="5"
                         PreviewTextInput="NumericTextBox_OnPreviewTextInput"
                         TextChanged="NumericTextBox_OnTextChanged"
                         AutomationProperties.Name="Hauteur du format d’image" />
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="22,8,22,0"
                       Foreground="#FFFF6B73" FontSize="11.5"
                       TextAlignment="Center" Visibility="Collapsed" />

            <StackPanel Grid.Row="4" Margin="22,12,22,18"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource TextButton}"
                        Margin="0,0,8,0" Click="Cancel_OnClick" />
                <Button Content="Appliquer" Style="{StaticResource TextButton}"
                        Background="#FFFF7A45" BorderBrush="#FFFF7A45"
                        Foreground="#FF120B07" FontWeight="SemiBold"
                        Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
