<Window x:Class="FusePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:FusePlayer.Controls"
        Title="Fuze"
        Icon="Assets/Fuse.ico"
        Width="1280"
        Height="748"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="Manual"
        Background="#FF050607"
        Foreground="#FFF7F7F7"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop"
        SizeChanged="Window_OnSizeChanged"
        LocationChanged="Window_OnLocationChanged"
        StateChanged="Window_OnStateChanged"
        DpiChanged="Window_OnDpiChanged"
        Closing="Window_OnClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="AppShell" Background="#FF050607" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="28" />
            <RowDefinition x:Name="MenuRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre sobre, inspirée de mpv.net -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="#FF24272B"
                BorderBrush="#FF34383D"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="Assets/FuseTransparentLogo.png"
                           Width="20" Height="20" Margin="0,0,7,0"
                           Stretch="Uniform" SnapsToDevicePixels="True" />
                    <TextBlock x:Name="WindowTitleText"
                               Text="Fuze"
                               VerticalAlignment="Center"
                               Foreground="#FFF5F5F5"
                               FontSize="13.5" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,2,2,0"
                            VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                            Width="42" Height="26" ToolTip="Réduire" Click="MinimizeButton_OnClick" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                            Width="42" Height="26" ToolTip="Agrandir" Click="MaximizeButton_OnClick" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                            Width="44" Height="26"
                            ToolTip="Fermer" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- La vidéo occupe tout l’espace restant -->
        <Grid x:Name="VideoViewport"
              Grid.Row="2"
              Background="#FF000000"
              ClipToBounds="True"
              SnapsToDevicePixels="True">
            <controls:VideoHwndHost x:Name="VideoView"
                                    Visibility="Collapsed"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True"
                                    SizeChanged="Window_OnSizeChanged" />
        </Grid>
        <Grid x:Name="OverlayParking" Grid.Row="2" Visibility="Visible">
            <Grid x:Name="VideoOverlay"
                  Background="#01000000"
                  SnapsToDevicePixels="True"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="VideoView_OnMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="VideoOverlay_OnMouseLeftButtonUp"
                  PreviewMouseMove="VideoOverlay_OnMouseMove"
                  PreviewMouseWheel="VideoOverlay_OnMouseWheel"
                  MouseRightButtonUp="VideoView_OnMouseRightButtonUp">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                     Cette surface opaque appartient au HWND d'overlay, donc
                     elle peut réellement couvrir la sortie native de mpv.
                     La vidéo reste visible pour le moteur pendant qu'il rend
                     sa première image en pause, sans montrer sa surface noire.
                -->
                <Border x:Name="StartupLoadingOverlay"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Panel.ZIndex="1000"
                        Background="#FF171C24"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Fuze"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFFF8A42"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StartupLoadingText"
                                   Text="Ouverture de la vidéo…"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFD4D8DE"
                                   FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Menu classique dans la couche vidéo pour éviter tout conflit d’airspace. -->
                <Grid x:Name="ToolBarHost"
                      Grid.Row="0"
                      Height="0"
                      VerticalAlignment="Top"
                      Panel.ZIndex="30"
                      Background="#A624272B"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      MouseEnter="ToolBarHost_OnMouseEnter"
                      MouseMove="ToolBarHost_OnMouseMove"
                      MouseLeave="ToolBarHost_OnMouseLeave">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ToolBarTranslate" Y="-5" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TopMenuContainer"
                            Grid.Column="0"
                            Height="29"
                            Margin="5,2,4,2"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="7">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="TopMenuScaleTransform" ScaleX="1" ScaleY="1" />
                    </Border.LayoutTransform>
                    <Menu x:Name="MenuBar"
                          Height="27"
                          Padding="0"
                          Background="Transparent"
                          Foreground="#FFF4F4F4"
                          FontFamily="Segoe UI"
                          FontSize="13"
                          Visibility="Collapsed"
                          VerticalContentAlignment="Center">
                        <Menu.Resources>
                            <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="Height" Value="27" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="Foreground" Value="#FFF5F5F5" />
                                <Setter Property="Background" Value="#F224272B" />
                                <Setter Property="BorderBrush" Value="#9943484F" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="TopItemBackground"
                                                        Margin="2,1"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter ContentSource="Header"
                                                                      RecognizesAccessKey="True"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <Popup x:Name="PART_Popup"
                                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                       Placement="Bottom"
                                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Fade">
                                                    <Border MinWidth="250"
                                                            Margin="0,1,0,0"
                                                            Padding="4"
                                                            Background="#F224272B"
                                                            BorderBrush="#AA43484F"
                                                            BorderThickness="1"
                                                            CornerRadius="0,0,6,6">
                                                        <ScrollViewer CanContentScroll="True"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="TopItemBackground" Property="Background" Value="#24FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="TopItemBackground" Property="Background" Value="#32FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="MinWidth" Value="242" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Foreground" Value="#FFF4F4F4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <Border x:Name="SubItemBackground"
                                                        Margin="0,1"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="16" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="CheckMark"
                                                                   Grid.Column="0"
                                                                   Text="✓"
                                                                   Foreground="#FFF5F5F5"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                        <ContentPresenter Grid.Column="1"
                                                                          Margin="5,0,18,0"
                                                                          ContentSource="Header"
                                                                          RecognizesAccessKey="True"
                                                                          VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{TemplateBinding InputGestureText}"
                                                                   Foreground="#FFB4B8BE"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="SubmenuArrow"
                                                                   Grid.Column="3"
                                                                   Text="›"
                                                                   Margin="5,0,0,0"
                                                                   Foreground="#FFD7DADE"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <Popup x:Name="PART_Popup"
                                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                       Placement="Right"
                                                       PlacementTarget="{Binding ElementName=SubItemBackground}"
                                                       HorizontalOffset="-2"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Fade">
                                                    <Border MinWidth="270"
                                                            Padding="4"
                                                            Background="#F224272B"
                                                            BorderBrush="#AA43484F"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <ScrollViewer CanContentScroll="True"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="SubItemBackground" Property="Background" Value="#2EFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="Separator">
                                <Setter Property="Height" Value="7" />
                                <Setter Property="Margin" Value="8,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Height="1"
                                                    VerticalAlignment="Center"
                                                    Background="#664A5057" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>

                        <MenuItem Header="Média" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem Header="Ouvrir un fichier…" InputGestureText="Ctrl+O" Click="OpenFilesButton_OnClick" />
                            <MenuItem Header="Ouvrir plusieurs fichiers…" InputGestureText="Ctrl+Maj+O" Click="OpenMultipleFilesButton_OnClick" />
                            <MenuItem Header="Ouvrir un dossier…" Click="OpenFolderButton_OnClick" />
                            <MenuItem Header="Ouvrir un disque…" Click="OpenDiscButton_OnClick" />
                            <Separator />
                            <MenuItem x:Name="RecentMediaMenuItem" Header="Médias récents"
                                      SubmenuOpened="RecentMediaMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucun média récent" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem Header="Enregistrer la liste de lecture…" Click="SavePlaylistButton_OnClick" />
                            <MenuItem Header="Ouvrir une liste de lecture…" Click="OpenPlaylistButton_OnClick" />
                            <Separator />
                            <MenuItem x:Name="MediaInformationMenuItem"
                                      Header="Informations sur le média…"
                                      Click="MediaInformationButton_OnClick" />
                            <MenuItem x:Name="AdditionalMediaInformationMenuItem"
                                      Header="Informations supplémentaires sur le média…"
                                      Click="AdditionalMediaInformationButton_OnClick" />
                            <MenuItem Header="Fermer le média actuel" Click="CloseCurrentMediaButton_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Lecture" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem Header="Lecture / pause" InputGestureText="Espace" Click="PlayButton_OnClick" />
                            <Separator />
                            <MenuItem x:Name="ChaptersMenuItem" Header="Chapitre"
                                      SubmenuOpened="ChaptersMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucun chapitre" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem Header="Aller à un temps spécifique…" Click="GoToTimeMenuItem_OnClick" />
                            <MenuItem x:Name="PlaybackSpeedMenuItem" Header="Vitesse de lecture"
                                      SubmenuOpened="PlaybackSpeedMenuItem_OnSubmenuOpened">
                                <MenuItem Header="1,00×" IsEnabled="False" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Chapitre précédent" Click="PreviousChapterMenuItem_OnClick" />
                            <MenuItem Header="Chapitre suivant" Click="NextChapterMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="Média précédent" Click="PreviousMediaMenuItem_OnClick" />
                            <MenuItem Header="Média suivant" Click="NextMediaMenuItem_OnClick" />
                            <Separator />
                            <MenuItem x:Name="RewindMenuItem" Header="Reculer de 15 secondes" InputGestureText="←" Click="RewindButton_OnClick" />
                            <MenuItem x:Name="ForwardMenuItem" Header="Avancer de 30 secondes" InputGestureText="→" Click="ForwardButton_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Audio" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem x:Name="AudioTracksMenuItem" Header="Choisir la piste"
                                      SubmenuOpened="AudioTracksMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucune piste audio" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem x:Name="AudioDevicesMenuItem" Header="Périphérique audio"
                                      SubmenuOpened="AudioDevicesMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Par défaut (Windows)" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem x:Name="AudioModesMenuItem" Header="Mode des canaux"
                                       SubmenuOpened="AudioModesMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Automatique (original)" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem x:Name="AudioProcessingMenuItem" Header="Traitement audio"
                                      SubmenuOpened="AudioProcessingMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucun traitement actif" IsEnabled="False" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Synchronisation audio…"
                                      Click="AudioSynchronizationMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="Augmenter le volume" InputGestureText="↑" Click="VolumeUpMenuItem_OnClick" />
                            <MenuItem Header="Baisser le volume" InputGestureText="↓" Click="VolumeDownMenuItem_OnClick" />
                            <MenuItem Header="Muet" InputGestureText="M" Click="MuteButton_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Vidéo" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem x:Name="VideoTracksMenuItem" Header="Choisir la piste"
                                      SubmenuOpened="VideoTracksMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucune piste vidéo" IsEnabled="False" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Plein écran" InputGestureText="F" Click="FullscreenButton_OnClick" />
                            <MenuItem Header="Capture d’écran" InputGestureText="S" Click="SnapshotButton_OnClick" />
                            <MenuItem x:Name="VideoZoomMenuItem" Header="Zoom"
                                      SubmenuOpened="VideoZoomMenuItem_OnSubmenuOpened">
                                <MenuItem Header="100 %" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem x:Name="VideoAspectMenuItem" Header="Format d’image"
                                      SubmenuOpened="VideoAspectMenuItem_OnSubmenuOpened">
                                <MenuItem Header="16:9" IsEnabled="False" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Synchronisation vidéo…"
                                      Click="VideoSynchronizationMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Sous-titres" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem x:Name="SubtitleTracksMenuItem" Header="Choisir la piste"
                                      SubmenuOpened="SubtitleTracksMenuItem_OnSubmenuOpened">
                                <MenuItem Header="Aucun sous-titre" IsEnabled="False" />
                            </MenuItem>
                            <MenuItem Header="Ajouter un fichier…" Click="AddSubtitleButton_OnClick" />
                            <Separator />
                            <MenuItem Header="Synchronisation des sous-titres…"
                                      Click="SubtitleSynchronizationMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Outils" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem Header="Synchronisation des pistes…"
                                      Click="TrackSynchronizationMenuItem_OnClick" />
                            <MenuItem Header="Réinitialiser la synchronisation"
                                      Click="ResetTrackSynchronizationMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="Paramètres…" Click="SettingsMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Aide" Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem Header="Raccourcis clavier" Click="ShortcutsMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="Informer d’un problème" Click="ReportProblemMenuItem_OnClick" />
                            <MenuItem Header="Site web de Fuze" Click="WebsiteMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="À propos de Fuze" Click="AboutMenuItem_OnClick" />
                        </MenuItem>
                    </Menu>
                    </Border>
                    <Button x:Name="ToolBarToggleButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Width="32"
                            Height="33"
                            Content="▼"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontFamily="Segoe UI Symbol"
                            FontSize="9"
                            Cursor="Arrow"
                            ToolTip="Afficher la barre des outils"
                            Click="ToolBarToggleButton_OnClick" />
                </Grid>

                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Grid Width="76" Height="76" Margin="0,0,0,16">
                        <Ellipse Fill="#17000000" Stroke="#44FFFFFF" StrokeThickness="1" />
                        <Path Data="M 29 21 L 57 38 L 29 55 Z" Fill="#FFF4F4F4" />
                    </Grid>
                    <TextBlock Text="Déposez une vidéo ici"
                               Foreground="#FFF4F4F4"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="ou utilisez Média  ›  Ouvrir des fichiers"
                               Foreground="#FF9A9FA5"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,16" />
                    <Button Content="Ouvrir un fichier" Style="{StaticResource TextButton}"
                            HorizontalAlignment="Center" Click="OpenFilesButton_OnClick" />
                </StackPanel>

                <Border x:Name="Toast"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Padding="14,8"
                        CornerRadius="5"
                        Background="#E51B1E23"
                        BorderBrush="#664F555D"
                        BorderThickness="1"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Panel.ZIndex="30">
                    <TextBlock x:Name="ToastText" Text="Volume 80 %" Foreground="White" FontSize="12" />
                </Border>

                <Border x:Name="VideoPanModeIndicator"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,60,0,0"
                        Padding="12,6"
                        CornerRadius="5"
                        Background="#E51B1E23"
                        BorderBrush="#CCFF9A48"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="31">
                    <TextBlock Text="Déplacement activé"
                               Foreground="#FFFFB276"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>

                <!-- Tiroir de playlist discret -->
                <Border x:Name="PlaylistPanel"
                        Grid.RowSpan="3"
                        Width="340"
                        Margin="0,12,12,108"
                        HorizontalAlignment="Right"
                        Background="#F0181B20"
                        BorderBrush="#FF454A52"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="Collapsed"
                        Panel.ZIndex="20">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="File des médias" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="PlaylistCountText" Text="0 élément" Foreground="#FF9A9FA5" FontSize="10" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                    Click="PlaylistToggleButton_OnClick" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <TextBox x:Name="PlaylistSearchTextBox"
                                     Height="32"
                                     Padding="10,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Background="#FF0C1016"
                                     BorderBrush="#FF3D4550"
                                     BorderThickness="1"
                                     Foreground="#FFF4F5F7"
                                     CaretBrush="#FFFF9A48"
                                     FontSize="12"
                                     ToolTip="Rechercher dans la file des médias"
                                     TextChanged="PlaylistSearchTextBox_OnTextChanged"
                                     GotKeyboardFocus="PlaylistSearchTextBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="PlaylistSearchTextBox_OnLostKeyboardFocus" />
                            <TextBlock x:Name="PlaylistSearchPlaceholderText"
                                       Text="Recherche de médias"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF858B92"
                                       FontSize="12"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Border Grid.Row="2" Height="1" Background="#FF3B4047" Margin="0,10,0,8" />
                        <ListBox x:Name="PlaylistList"
                                 Grid.Row="3"
                                 ItemsSource="{Binding Playlist}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="PlaylistList_OnSelectionChanged"
                                 MouseDoubleClick="PlaylistList_OnMouseDoubleClick"
                                 PreviewKeyDown="PlaylistList_OnPreviewKeyDown"
                                 PreviewMouseLeftButtonDown="PlaylistList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="PlaylistList_OnPreviewMouseLeftButtonUp"
                                 PreviewMouseMove="PlaylistList_OnPreviewMouseMove">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource FuzeScrollBarContextMenuHostStyle}">
                                    <Setter Property="Width" Value="12" />
                                    <Setter Property="Background" Value="#FF14171B" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Width="12" Background="{TemplateBinding Background}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="13" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="13" />
                                                    </Grid.RowDefinitions>
                                                    <RepeatButton Grid.Row="0"
                                                                  Command="{x:Static ScrollBar.LineUpCommand}"
                                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="#FF20242A" BorderThickness="0"
                                                                  Style="{StaticResource FuzeScrollBarRepeatButton}">
                                                        <Path Data="M 0,3 L 2.5,0.5 L 5,3" Width="5" Height="3"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </RepeatButton>
                                                    <Track x:Name="PART_Track" Grid.Row="1" Width="12"
                                                           HorizontalAlignment="Center" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                          Background="Transparent" BorderThickness="0"
                                                                          Style="{StaticResource FuzeScrollBarRepeatButton}" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Width="8" MinHeight="30" HorizontalAlignment="Center">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#FF626872"
                                                                                CornerRadius="4"
                                                                                SnapsToDevicePixels="False"
                                                                                UseLayoutRounding="False" />
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                          Background="Transparent" BorderThickness="0"
                                                                          Style="{StaticResource FuzeScrollBarRepeatButton}" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                    <RepeatButton Grid.Row="2"
                                                                  Command="{x:Static ScrollBar.LineDownCommand}"
                                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="#FF20242A" BorderThickness="0"
                                                                  Style="{StaticResource FuzeScrollBarRepeatButton}">
                                                        <Path Data="M 0,0 L 2.5,2.5 L 5,0" Width="5" Height="3"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Fill="Transparent" Stroke="#FF858A92" StrokeThickness="1"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </RepeatButton>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
