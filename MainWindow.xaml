                                        <DataTrigger Binding="{Binding IsEnhancedQueued}" Value="True">
                                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
