                                </Button>
                                <Button x:Name="PreviousButton" Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="1,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip="Chapitre précédent, puis média précédent (P)" Click="PreviousButton_OnClick">
                                    <Viewbox Width="21" Height="21" Stretch="Uniform" IsHitTestVisible="False">
                                        <Canvas Width="20" Height="20">
                                            <Path Data="M 3,3 L 3,17"
                                                  Stroke="#FFF4F4F4" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path Data="M 17,3 L 6,10 L 17,17 Z" Fill="#FFF4F4F4" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="RewindButton" Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="1,0" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         ToolTip="Reculer (←)" Click="RewindButton_OnClick">
                                    <Path Width="21" Height="21"
                                          Data="M 18,19 C 21,13 19,7 13,4 C 11,3 8,3 6,4 M 6,4 L 10,1 M 6,4 L 9,8"
                                          Fill="Transparent" Stroke="#FFF4F4F4" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="Uniform" IsHitTestVisible="False" />
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}"
                                        Width="36" Height="34" Margin="1,0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Lecture / pause"
                                        ToolTip="Lecture / pause (Espace)" Click="PlayButton_OnClick">
                                    <Grid Width="22" Height="22" IsHitTestVisible="False">
                                        <Path x:Name="PlayGlyph"
                                              Data="M 7,3 L 19,11 L 7,19 Z"
                                              Fill="#FFF4F4F4"
                                              Stretch="None" />
                                        <Grid x:Name="PauseGlyph" Width="22" Height="22" Visibility="Collapsed">
                                            <Rectangle Width="4" Height="16" Margin="5,0,0,0"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       RadiusX="1" RadiusY="1" Fill="#FFF4F4F4" />
                                            <Rectangle Width="4" Height="16" Margin="0,0,5,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       RadiusX="1" RadiusY="1" Fill="#FFF4F4F4" />
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="1,0" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         ToolTip="Avancer (→)" Click="ForwardButton_OnClick">
                                    <Path Width="21" Height="21"
                                          Data="M 6,19 C 3,13 5,7 11,4 C 13,3 16,3 18,4 M 18,4 L 14,1 M 18,4 L 15,8"
                                          Fill="Transparent" Stroke="#FFF4F4F4" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="Uniform" IsHitTestVisible="False" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="1,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip="Chapitre suivant, puis média suivant (N)" Click="NextButton_OnClick">
                                    <Viewbox Width="21" Height="21" Stretch="Uniform" IsHitTestVisible="False">
                                        <Canvas Width="20" Height="20">
                                            <Path Data="M 17,3 L 17,17"
                                                  Stroke="#FFF4F4F4" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path Data="M 3,3 L 14,10 L 3,17 Z" Fill="#FFF4F4F4" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>

                            <Grid x:Name="NowPlayingTitleHost" Grid.Column="1" MinWidth="0" Margin="10,0,14,0">
                                <TextBlock x:Name="NowPlayingTitle"
                                           Text="Aucun média"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           ToolTipService.InitialShowDelay="350"
                                           ToolTipService.ShowDuration="10000"
                                           ToolTipOpening="NowPlayingTitle_OnToolTipOpening"
                                           Foreground="#FFD9DCE1"
                                           FontSize="15"
                                           FontWeight="Normal" />
                                <TextBlock x:Name="NowPlayingDetail" Text="" Visibility="Collapsed" />
                            </Grid>
                            </Grid>

                            <StackPanel x:Name="TimelineTextHost" Grid.Column="1" Panel.ZIndex="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                 <TextBlock x:Name="ElapsedText" Text="00:00"
                                            Foreground="White" FontFamily="Cascadia Mono" FontSize="16"
                                            MinWidth="125"
                                            TextAlignment="Right" VerticalAlignment="Center" Cursor="Arrow"
                                           ToolTip="Clic gauche : afficher ou masquer les millisecondes"
                                           MouseLeftButtonUp="ElapsedText_OnMouseLeftButtonUp" />
                                <TextBlock x:Name="TimelineSeparatorText" Text="/" Margin="8,0" Foreground="#FF8E949C"
                                           FontFamily="Cascadia Mono" FontSize="14"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                 <TextBlock x:Name="DurationText" Text="-00:00"
                                            Foreground="White" FontFamily="Cascadia Mono" FontSize="16"
                                            MinWidth="135"
                                            TextAlignment="Left" VerticalAlignment="Center" Cursor="Arrow"
                                           ToolTip="Clic gauche : temps restant ou durée totale"
                                           MouseLeftButtonUp="DurationText_OnMouseLeftButtonUp" />
                            </StackPanel>

                            <StackPanel x:Name="RightControlsHost" Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ScreenshotButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Padding="0"
                                        Content="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                        Visibility="Collapsed"
                                         ToolTip="Capture d’écran (S)"
                                        Click="SnapshotButton_OnClick" />
                                <Button x:Name="ShuffleButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                         ToolTip="Lecture aléatoire (H)"
                                        Click="ShuffleButton_OnClick">
                                    <Button.Content>
                                        <Viewbox Width="19" Height="19" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3.5,7 H7 C10,7 14,17 17,17 H20.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent" />
                                                <Path Data="M3.5,17 H7 C10,17 14,7 17,7 H20.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent" />
                                                <Path Data="M17.2,3.8 L20.5,7 L17.2,10.2 M17.2,13.8 L20.5,17 L17.2,20.2"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button.Content>
                                </Button>
                                <Button x:Name="RepeatButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                         ToolTip="Répéter le média actuel (R)"
                                        Click="RepeatButton_OnClick">
                                    <Button.Content>
                                        <Viewbox Width="19" Height="19" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4.5,14 C2,11 4.5,6 9,6 H19.5 M19.5,10 C22,13 19.5,18 15,18 H4.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent" />
                                                <Path Data="M19.5,6 L16.2,3.2 M19.5,6 L16.2,8.8 M4.5,18 L7.8,15.2 M4.5,18 L7.8,20.8"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button.Content>
                                </Button>
                                <Button x:Name="AudioTracksButton"
                                        Style="{StaticResource IconButton}"
                                        Width="54" Height="34" Margin="4,0" Padding="0" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Foreground="White"
                                         ToolTip="Audio (A) : clic gauche ou molette pour changer, clic droit pour la liste"
                                        Click="AudioTracksButton_OnCycleClick"
                                        PreviewMouseWheel="AudioTracksButton_OnMouseWheel"
                                        MouseRightButtonUp="AudioTracksButton_OnMouseRightButtonUp">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="AudioTrackCountText" Text="0/0" FontFamily="Cascadia Mono"
                                                   FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SubtitleTracksButton"
                                        Style="{StaticResource IconButton}"
                                        Width="54" Height="34" Margin="4,0" Padding="0" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Foreground="White"
                                         ToolTip="Sous-titres (T) : clic gauche ou molette pour changer, clic droit pour la liste"
                                        Click="SubtitleTracksButton_OnCycleClick"
                                        PreviewMouseWheel="SubtitleTracksButton_OnMouseWheel"
                                        MouseRightButtonUp="SubtitleTracksButton_OnMouseRightButtonUp">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7F0;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="SubtitleTrackCountText" Text="0/0" FontFamily="Cascadia Mono"
                                                   FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SpeedButton" Content="1,00×"
                                        Style="{StaticResource IconButton}"
                                        Width="52" Height="34" Margin="4,0" Padding="0" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        FontFamily="Cascadia Mono" FontSize="13"
                                         Foreground="#FFF5F5F5" ToolTip="Vitesse (V, [ et ])"
                                        Click="SpeedButton_OnClick" />
                                <Button x:Name="TrackSynchronizationButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                         ToolTip="Synchronisation des pistes (Y)"
                                        automation:AutomationProperties.Name="Ouvrir la synchronisation des pistes"
                                        Click="TrackSynchronizationMenuItem_OnClick">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform" IsHitTestVisible="False">
                                        <Canvas Width="18" Height="18">
                                            <Path Data="M2,4 L16,4 M2,9 L16,9 M2,14 L16,14"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Ellipse Canvas.Left="5" Canvas.Top="1.5" Width="5" Height="5"
                                                     Fill="#FF24272B"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     StrokeThickness="1.5" />
                                            <Ellipse Canvas.Left="10" Canvas.Top="6.5" Width="5" Height="5"
                                                     Fill="#FF24272B"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     StrokeThickness="1.5" />
                                            <Ellipse Canvas.Left="3" Canvas.Top="11.5" Width="5" Height="5"
                                                     Fill="#FF24272B"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="VideoPanButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        ToolTip="Déplacement de l’écran (G)"
                                        Click="VideoPanButton_OnClick">
                                    <Viewbox Width="19" Height="19" Stretch="Uniform" IsHitTestVisible="False">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12,2 L12,8 M12,2 L9,5 M12,2 L15,5 M12,22 L12,16 M12,22 L9,19 M12,22 L15,19 M2,12 L8,12 M2,12 L5,9 M2,12 L5,15 M22,12 L16,12 M22,12 L19,9 M22,12 L19,15"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="OptionsBarPinButton"
                                        Style="{StaticResource IconButton}"
                                        Width="32" Height="34" Margin="4,0" Content="&#xE713;"
                                        FontFamily="Segoe Fluent Icons" FontSize="16"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Foreground="#FFD8DBDF" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center"
                                         ToolTip="Afficher et garder la barre des options ouverte (I)"
                                        Click="OptionsBarPinButton_OnClick" />
                                <Button x:Name="MuteButton"
                                        Width="32" Height="34" Margin="4,0"
                                        Style="{StaticResource IconButton}"
                                        Background="Transparent" BorderThickness="0" Foreground="#FFFF9A48"
                                        FontFamily="Segoe Fluent Icons" FontSize="16" Content="&#xE767;"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                         ToolTip="Clic gauche : muet (M) • clic droit : options du volume"
                                        Click="MuteButton_OnClick"
                                        MouseRightButtonUp="MuteButton_OnMouseRightButtonUp"
                                        PreviewMouseWheel="VolumeControl_OnMouseWheel"
                                        MouseEnter="MuteButton_OnMouseEnter"
                                        MouseLeave="MuteButton_OnMouseLeave" />
                                <Grid x:Name="VolumeControlHost" Width="100" Height="26" Margin="4,0" VerticalAlignment="Center">
                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0" Maximum="125" Value="100"
                                            Visibility="Collapsed" ValueChanged="VolumeSlider_OnValueChanged" />
                                    <Canvas x:Name="VolumeTriangleCanvas" Width="96" Height="26"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="VolumeHitArea"
                                              Data="M 2,24 L 94,24 L 94,2 Z"
                                              Fill="#FFF2F2F2" Stroke="#FF777C82" StrokeThickness="1"
                                              Cursor="Arrow"
                                              MouseLeftButtonDown="VolumeControl_OnMouseLeftButtonDown"
                                              MouseLeftButtonUp="VolumeControl_OnMouseLeftButtonUp"
                                              MouseMove="VolumeControl_OnMouseMove"
                                              PreviewMouseWheel="VolumeControl_OnMouseWheel"
                                              MouseRightButtonUp="VolumeControl_OnMouseRightButtonUp" />
                                        <Path x:Name="VolumeFillPath"
                                              Data="M 2,24 L 94,24 L 94,2 Z"
                                              Fill="#FFFF8A42" StrokeThickness="0" IsHitTestVisible="False">
                                            <Path.Clip>
                                                <RectangleGeometry x:Name="VolumeFillClip" Rect="0,0,75.6,26" />
                                            </Path.Clip>
                                        </Path>
                                        <TextBlock x:Name="VolumeText"
                                                   Canvas.Left="58" Canvas.Top="10"
                                                   Width="35" Height="14"
                                                   Text="100%"
                                                   Foreground="#FF101214"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Canvas>
                                    <Grid x:Name="VolumeCompactBarHost" Width="112" Height="26"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed">
                                        <Slider x:Name="CompactVolumeSlider"
                                                Minimum="0" Maximum="125"
                                                Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}"
                                                Foreground="#FFFF8A42"
                                                Background="#66737A84"
                                                ToolTip="Volume : molette pour régler • clic droit : périphériques"
                                                PreviewMouseWheel="VolumeControl_OnMouseWheel"
                                                MouseRightButtonUp="VolumeControl_OnMouseRightButtonUp" />
                                    </Grid>
                                    <Grid x:Name="VolumeInlineBarHost" Width="150" Height="26"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="InlineVolumeSlider"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="125"
                                                Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}"
                                                Foreground="#FFFF8A42"
                                                Background="#66737A84"
                                                VerticalAlignment="Center"
                                                ToolTip="Volume : molette pour régler • clic droit : périphériques"
                                                PreviewMouseWheel="VolumeControl_OnMouseWheel"
                                                MouseRightButtonUp="VolumeControl_OnMouseRightButtonUp" />
                                        <TextBlock x:Name="VolumeInlineBarText"
                                                   Grid.Column="1"
                                                   Text="100%"
                                                   Margin="8,0,0,0"
                                                   Foreground="#FFF4F5F7"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="BottomBarLayoutVolumePlaceholder"
                                               Text="Volume"
                                               Panel.ZIndex="50"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False"
                                               Foreground="#FFF4F5F7"
                                               Background="#CC171B21"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                        Width="32" Height="34" Margin="4,0" FontSize="18" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip="Plein écran (F)" Click="FullscreenButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Mise en page configurable : les contrôles sont répartis
                         dans trois lignes/zones et leur espacement est appliqué
                         automatiquement par MainWindow. -->
                    <Grid x:Name="BottomBarCustomLayoutGrid"
                          Grid.Row="1"
                          Margin="8,0,8,0"
                          Panel.ZIndex="25"
                          Visibility="Collapsed"
                          ClipToBounds="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="BottomBarCustomLayoutTranslateTransform" />
                        </Grid.RenderTransform>
                        <Grid x:Name="BottomBarLegacyLayoutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="BottomBarLeftHost"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                            <StackPanel x:Name="BottomBarCenterHost"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            <StackPanel x:Name="BottomBarRightHost"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                        </Grid>
                        <Canvas x:Name="BottomBarFreeLayoutCanvas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Visibility="Collapsed"
                                ClipToBounds="False"
                                SizeChanged="BottomBarFreeLayoutCanvas_OnSizeChanged" />
                    </Grid>

                    <!-- Repères de placement affichés directement sur la vraie
                         barre inférieure pendant l’édition. L’overlay est
                         volontairement au-dessus des commandes : MainWindow
                         relaie uniquement les glisser-déposer autorisés et
                         bloque les clics accidentels sur le lecteur. -->
                    <Grid x:Name="BottomBarLayoutGuideOverlay"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          Width="{Binding ActualWidth, ElementName=BottomBarCustomLayoutGrid}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="100"
                          IsHitTestVisible="True"
                          Background="#01000000"
                          AllowDrop="True"
                          Visibility="Collapsed"
                          ClipToBounds="False"
                          PreviewMouseLeftButtonDown="BottomBarLayoutGuide_OnPreviewMouseLeftButtonDown"
                          PreviewMouseMove="BottomBarLayoutGuide_OnPreviewMouseMove"
                          PreviewMouseLeftButtonUp="BottomBarLayoutGuide_OnPreviewMouseLeftButtonUp"
                          PreviewDragOver="BottomBarLayout_OnDragOver"
                          PreviewDrop="BottomBarLayout_OnDrop">
                        <!-- Cadres temporaires montrant la zone complète de
                             chaque commande pendant l'édition. -->
                        <Canvas x:Name="BottomBarLayoutItemBoundsCanvas"
                                Panel.ZIndex="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                ClipToBounds="False" />
                        <Border x:Name="BottomBarLayoutCenterLine" Height="2" Margin="0,38,0,0"
                                Panel.ZIndex="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="#FFFF8A42"
                                Opacity="0.9" />
                        <Grid x:Name="BottomBarLayoutVerticalGuides"
                              Panel.ZIndex="1"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#FFFF8A42" BorderThickness="0,0,2,0" Opacity="0.9" />
                            <Border Grid.Column="1" BorderBrush="#FFFF8A42" BorderThickness="0,0,2,0" Opacity="0.9" />
                            <Border Grid.Column="2" BorderBrush="#FFFF8A42" BorderThickness="0,0,2,0" Opacity="0.9" />
                        </Grid>
                    </Grid>
                    </Grid>
                </Border>
            <Border x:Name="VolumeIndicatorOverlay"
                    Grid.Row="1"
                    Width="360"
                    Height="48"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="22"
                    Background="#E6252933"
                    BorderBrush="#664B515B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Grid Margin="12,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE767;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="20"
                               Foreground="#FFFF9A48"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Border x:Name="VolumeIndicatorTrack"
                            Grid.Column="1"
                            Height="10"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="#66737A84"
                            CornerRadius="5">
                        <Border x:Name="VolumeIndicatorFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="#FFFF8A42"
                                CornerRadius="5" />
                    </Border>
                    <TextBlock x:Name="VolumeIndicatorText"
                               Grid.Column="2"
                               Text="100 %"
                               Margin="10,0,0,0"
                               Foreground="#FFF4F5F7"
                               FontFamily="Cascadia Mono"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="VolumePopup"
                    Grid.Row="1"
                    Width="250"
                    Height="68"
                    Margin="0,0,12,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="24"
                    Background="#F0262A34"
                    BorderBrush="#B44B515B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed"
                    MouseEnter="VolumePopup_OnMouseEnter"
                    MouseLeave="VolumePopup_OnMouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#FF000000" Opacity="0.45" />
                </Border.Effect>
                <Grid Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE767;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="18"
                               Foreground="#FFF2F4F7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Slider x:Name="VolumePopupSlider"
                            Grid.Column="1"
                            Margin="4,0"
                            Minimum="0" Maximum="125"
                            Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}"
                            Foreground="#FFFF8A42"
                            Background="#66737A84"
                            VerticalAlignment="Center"
                            PreviewMouseWheel="VolumeControl_OnMouseWheel" />
                    <TextBlock x:Name="VolumePopupPercent"
                               Grid.Column="2"
                               Text="100"
                               Foreground="#FFF4F5F7"
                               FontFamily="Cascadia Mono"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
