<Window x:Class="FusePlayer.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis clavier"
        Width="700" Height="650"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="DialogScrollBarRepeatButton" TargetType="RepeatButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="RepeatButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF2B3038" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RepeatButtonBorder" Property="Background" Value="#FF343B45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rail Fuse : fin, arrondi et sans les flèches natives Windows. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource FuzeScrollBarContextMenuHostStyle}">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="#221F252E" />
            <Setter Property="Foreground" Value="#FF555D68" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="11" Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Width="11"
                                   HorizontalAlignment="Center"
                                   IsDirectionReversed="True"
                                   ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Style="{StaticResource DialogScrollBarRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="7" MinHeight="34" Margin="0,2"
                                           HorizontalAlignment="Center" ClipToBounds="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ScrollThumb"
                                                        Background="#FF555D68"
                                                        CornerRadius="3.5" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ScrollThumb"
                                                                Property="Background"
                                                                Value="#FFFF8A58" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ScrollThumb"
                                                                Property="Background"
                                                                Value="#FFFFA06A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Style="{StaticResource DialogScrollBarRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FF11151C"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF24272B"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="17,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Margin="0,0,10,0"
                           Source="Assets/FuseTransparentLogo.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Raccourcis clavier"
                                   Foreground="#FFF4F5F7"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Commandes actuellement attribuées à Fuze"
                                   Foreground="#FF9EA5AF"
                                   FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="34" Height="34"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fermer"
                            Click="Close_OnClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,17,22,12">
                <TextBlock Text="Liste complète"
                           Foreground="#FFFF7A45"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Text="Cette liste reflète les touches enregistrées dans Paramètres › Raccourcis."
                           Foreground="#FFB8BEC7"
                           FontSize="12.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="18,0,18,10"
                    Background="#FF0D1117"
                    BorderBrush="#FF2C333D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="7">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                    <ItemsControl x:Name="ShortcutItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2"
                                        Padding="10,9"
                                        Background="#141F252E"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#FFF4F5F7"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,12,0"
                                                       Text="{Binding Description}"
                                                       Foreground="#FF929AA5"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                MinWidth="96"
                                                Margin="12,0,0,0"
                                                Padding="9,5"
                                                Background="#FF242A33"
                                                BorderBrush="#FF3C4551"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Gesture}"
                                                       Foreground="#FFFFA06A"
                                                       FontFamily="Cascadia Mono"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="22,0,22,18">
                <TextBlock Text="Les raccourcis se modifient dans Paramètres › Raccourcis."
                           Foreground="#FF8C929F"
                           FontSize="11.5"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Modifier"
                            Style="{StaticResource TextButton}"
                            Margin="0,0,8,0"
                            Click="Modify_OnClick" />
                    <Button Content="Fermer"
                            Style="{StaticResource TextButton}"
                            IsDefault="True"
                            Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
