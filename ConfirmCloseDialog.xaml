<Window x:Class="FusePlayer.ConfirmCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fermer Fuse"
        Width="470"
        Height="224"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="13"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="23" Height="23" Margin="0,0,9,0"
                           Source="Assets/FuseTransparentLogo.png"
                           Stretch="Uniform" />
                    <TextBlock x:Name="DialogTitleTextBlock" Grid.Column="1"
                               Text="Fermer Fuse"
                               Foreground="#FFF4F5F7"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Width="32" Height="32"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;"
                            ToolTip="Annuler"
                            Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,8">
                <TextBlock x:Name="DialogQuestionTextBlock" Text="Fermer Fuse ?"
                           Foreground="#FFF4F5F7"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DialogDescriptionTextBlock" Margin="0,7,0,0"
                           Text="La lecture en cours sera arrêtée et la session sera enregistrée."
                           Foreground="#FF9EA5AF"
                           FontSize="12.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="22,10,22,18"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Style="{StaticResource TextButton}"
                        Margin="0,0,9,0"
                        IsCancel="True"
                        Click="Cancel_OnClick" />
                <Button x:Name="DialogConfirmButton" Content="Fermer Fuse"
                        Style="{StaticResource TextButton}"
                        Background="#FFFF7A45"
                        BorderBrush="#FFFF7A45"
                        Foreground="#FF120B07"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
