<Window x:Class="FusePlayer.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ouvrir un flux"
        Width="520"
        Height="220"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Ouvrir un flux réseau"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#FFF4F5F7" />
            <TextBlock Grid.Row="1"
                       Margin="0,5,0,14"
                       Text="Collez une adresse HTTP, HTTPS, RTSP, RTP ou autre URL compatible VLC."
                       FontSize="12"
                       Foreground="#FF8C929F" />
            <TextBox x:Name="ValueTextBox"
                     Grid.Row="2"
                     Height="38"
                     Padding="11,7"
                     VerticalContentAlignment="Center"
                     Background="#FF0D1117"
                     Foreground="#FFF4F5F7"
                     BorderBrush="#FF343B47"
                     CaretBrush="#FFFF7A45"
                     SelectionBrush="#88FF7A45"
                     FontSize="13"
                     KeyDown="ValueTextBox_OnKeyDown" />

            <StackPanel Grid.Row="4" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource TextButton}" Margin="0,0,8,0" Click="Cancel_OnClick" />
                <Button Content="Lire le flux" Style="{StaticResource TextButton}" Background="#FFFF7A45" BorderBrush="#FFFF7A45" Foreground="#FF120B07" FontWeight="SemiBold" Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
