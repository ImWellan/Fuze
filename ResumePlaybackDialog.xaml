<Window x:Class="FusePlayer.ResumePlaybackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reprendre la lecture"
        Width="520"
        Height="248"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="13"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="23" Height="23" Margin="0,0,9,0"
                           Source="Assets/FuseTransparentLogo.png"
                           Stretch="Uniform" />
                    <TextBlock Grid.Column="1"
                               Text="Reprendre la lecture"
                               Foreground="#FFF4F5F7"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="MediaTitleText"
                       Grid.Row="1"
                       Margin="22,17,22,0"
                       Foreground="#FFF4F5F7"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PositionText"
                       Grid.Row="2"
                       Margin="22,5,22,0"
                       Foreground="#FFFF9A48"
                       FontFamily="Cascadia Mono"
                       FontSize="13" />
            <TextBlock Grid.Row="3"
                       Margin="22,7,22,0"
                       Text="Souhaites-tu reprendre à cette position ou recommencer au début ?"
                       Foreground="#FF9EA5AF"
                       FontSize="12.5"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="4" Margin="22,16,22,18"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Recommencer"
                        Style="{StaticResource TextButton}"
                        Margin="0,0,9,0"
                        Click="Restart_OnClick" />
                <Button Content="Reprendre"
                        Style="{StaticResource TextButton}"
                        Background="#FFFF7A45"
                        BorderBrush="#FFFF7A45"
                        Foreground="#FF120B07"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="Resume_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
