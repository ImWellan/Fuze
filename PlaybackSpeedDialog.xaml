<Window x:Class="FusePlayer.PlaybackSpeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitesse de lecture personnalisée"
        Width="430" Height="228"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Arrow"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FontFamily="Segoe UI Variable Text">
    <Border Background="#FF171C24"
            BorderBrush="#FF343B47"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF24272B" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="17,0,8,0"
                               Text="Vitesse de lecture personnalisée"
                               Foreground="#FFF4F5F7"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <Button Grid.Column="1"
                            Width="42" Height="42"
                            Style="{StaticResource DialogCloseWindowButton}"
                            Content="&#xE8BB;"
                            ToolTip="Fermer"
                            Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="22,16,22,12"
                       Text="Entrez un multiplicateur compris entre 0,05× et 10,00×."
                       Foreground="#FFC7CBD1" FontSize="12.5" />

            <Grid Grid.Row="2" Width="150" HorizontalAlignment="Center">
                <TextBox x:Name="SpeedTextBox"
                         AutomationProperties.Name="Multiplicateur de vitesse"
                         Height="38" Padding="10,5,38,5"
                         Background="#FF0D1117" Foreground="#FFF4F5F7"
                         BorderBrush="#FF3A414C" BorderThickness="1"
                         CaretBrush="#FFFF7A45" SelectionBrush="#88FF7A45"
                         FontFamily="Cascadia Mono" FontSize="19"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         SnapsToDevicePixels="True" UseLayoutRounding="True"
                         MaxLength="6"
                         PreviewTextInput="SpeedTextBox_OnPreviewTextInput"
                         TextChanged="SpeedTextBox_OnTextChanged" />
                <TextBlock Text="×" Margin="0,0,14,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#FFFF9A48" FontFamily="Cascadia Mono"
                           FontSize="18" FontWeight="SemiBold"
                           IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="22,8,22,0"
                       Foreground="#FFFF6B73" FontSize="11.5"
                       TextAlignment="Center" Visibility="Collapsed" />

            <StackPanel Grid.Row="4" Margin="22,12,22,18"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource TextButton}"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
                <Button Content="Appliquer"
                        Style="{StaticResource TextButton}"
                        Background="#FFFF7A45" BorderBrush="#FFFF7A45"
                        Foreground="#FF120B07" FontWeight="SemiBold"
                        IsDefault="True" Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
